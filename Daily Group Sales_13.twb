            <column caption='Sales region' datatype='string' name='[Calculation_1051872033104461825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//daan: in the old solution this was a group. I prefer a calculated field because it is more clear how it works.&#13;&#10;if [customer_sales_business_unit] = &apos;Agerpol&apos;                   then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Austria&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Baltics&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Belgium&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Bulgaria&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Croatia and Slovenia&apos;  then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Czech Republic&apos;        then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Denmark&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export ROW&apos;            then &apos;ROW&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export SEE&apos;            then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Finland&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;France&apos;                then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Germany&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Grene Retail&apos;          then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Hungary&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;INDI&apos;                  then &apos;INDI&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Italy&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Netherlands&apos;           then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Norway&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland&apos;                then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland Franchise&apos;      then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Raico&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Recinsa&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Republic of Ireland&apos;   then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Romania&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Russia&apos;                then &apos;Russia&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Slovakia&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Spain&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Sweden&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Switzerland&apos;           then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Ukraine&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;United Kingdom&apos;        then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;UK &amp; Ireland&apos;          then &apos;1 - North West&apos;   //Daan: added this one&#13;&#10;elseif [customer_sales_business_unit] = &apos;Tehnikakeskus&apos;          then &apos;3 - East&apos;        //Daan: added this one&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>coming from CSBU</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
