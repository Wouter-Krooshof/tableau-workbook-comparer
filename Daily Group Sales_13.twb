        <calculation class='tableau' formula='sum(if [ind_CY YTD (rel) (copy)_236720504437403662] then [Turnover (copy)_1754433544814776320] end) &#13;&#10;/ &#13;&#10;sum(if [ind_CY YTD (rel) (copy)_236720504437403662] then [budget_turnover] end)' />
      </column>
