      <column caption='Margin % lc budget CY' datatype='real' default-format='p0.0%' name='[Margin % budget CY (copy)_413205315878617112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Margin Budget CY (copy)_413205315878776857])&#13;&#10;/&#13;&#10;sum([Turnover Budget CY (copy)_1698138576777445384])' />
