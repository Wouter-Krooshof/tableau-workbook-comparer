            </column>
            <column caption='dummy' datatype='integer' datatype-customized='true' name='[Calculation_874542792794222593]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INT(null)' />
            </column>
            <column caption='Daily average # Orderlines LY' datatype='real' name='[Daily average turnover CY  (copy)_1766818465106255875 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Turnover CY (copy)_1195142760512356366 1])&#13;&#10;/ &#13;&#10;[# invoicing days CY (copy)_1766818465106362372]' />
