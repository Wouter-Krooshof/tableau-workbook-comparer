        <rows onTop='true'>([federated.07pdzlx0k2seif18uh2zd1jwbeij].[win:sum:Calculation_1813824758949527643:qk:2] + ([federated.07pdzlx0k2seif18uh2zd1jwbeij].[usr:Calculation_1410752630613745666:qk:2] + ([federated.07pdzlx0k2seif18uh2zd1jwbeij].[win:sum:Calculation_1372190548022374405:qk:6] + [federated.07pdzlx0k2seif18uh2zd1jwbeij].[usr:Margin % CY (copy)_411516457497165824:qk])))</rows>
        <cols>([federated.07pdzlx0k2seif18uh2zd1jwbeij].[none:per what filter segment (copy)_280630594442031106:nk] * [federated.07pdzlx0k2seif18uh2zd1jwbeij].[tmn:invoice_date:qk])</cols>
