              <calculation class='tableau' formula='CASE [Parameters].[pm_per what 1 (segment or product category) (copy)_280630594441756673 1]&#13;&#10;//WHEN 1 then [Segment_2_Industry]&#13;&#10;WHEN 2 then [product_category]&#13;&#10;WHEN 3 THEN [csbu_country_reporting]&#13;&#10;WHEN 4 THEN [segment_4_local]&#13;&#10;WHEN 6 THEN [market_type] &#13;&#10;WHEN 7 THEN [cluster] &#13;&#10;WHEN 8 THEN [industry] &#13;&#10;WHEN 9 THEN [business_type]&#13;&#10;WHEN 10 THEN [business_type_group_1]&#13;&#10;WHEN 11 THEN [business_type_group_2]&#13;&#10;WHEN 12 THEN [customer_sales_business_unit]&#13;&#10;ELSE Null end' />
