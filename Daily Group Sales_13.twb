            </column>
            <column caption='Sales region' datatype='string' name='[Calculation_1051872033104461825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//daan: in the old solution this was a group. I prefer a calculated field because it is more clear how it works.&#13;&#10;if [customer_sales_business_unit] = &apos;Agerpol&apos;                   then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Austria&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Baltics&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Belgium&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Bulgaria&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Croatia and Slovenia&apos;  then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Czech Republic&apos;        then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Denmark&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export ROW&apos;            then &apos;ROW&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export SEE&apos;            then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Finland&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;France&apos;                then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Germany&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Grene Retail&apos;          then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Hungary&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;INDI&apos;                  then &apos;INDI&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Italy&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Netherlands&apos;           then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Norway&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland&apos;                then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland Franchise&apos;      then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Raico&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Recinsa&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Republic of Ireland&apos;   then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Romania&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Russia&apos;                then &apos;Russia&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Slovakia&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Spain&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Sweden&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Switzerland&apos;           then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Ukraine&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;United Kingdom&apos;        then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;UK &amp; Ireland&apos;          then &apos;1 - North West&apos;   //Daan: added this one&#13;&#10;elseif [customer_sales_business_unit] = &apos;Tehnikakeskus&apos;          then &apos;3 - East&apos;        //Daan: added this one&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>coming from CSBU</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [source]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;     when  &apos;ProductCategoryBudget_Rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
            </column>
            <column caption='Margin Eur' datatype='real' hidden='true' name='[Calculation_1372190548006633472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[margin_euro]&#13;&#10;//makes it easier to copy paste formulas from sales nordics' />
            </column>
            <column caption='Margin % budget CY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008140802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Turnover Budget CY (copy)_1754433544820387844])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])' />
            </column>
            <column caption='Margin % LY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008853507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Margin choosen CY (copy)_1195142760560619536])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1195142760512356366])' />
            </column>
            <column caption='Date per CSBU' datatype='date' name='[Calculation_1567252717417353216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//daan: handy to have a field in beteween. With this 1 I can - for test purposes - swith between the 2 date fields.&#13;&#10;//[Invoice Date]        //coming from hte big TO table&#13;&#10;//[dateFull (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]             //coming from the small dates table&#13;&#10;[date_full]' />
            </column>
            <column caption='pm date feed ind (1)' datatype='boolean' name='[Calculation_1813824758940864589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//the goal: show all dates before today, but be carefull with yesterday. Yesterday should only be there if there is salesdata.&#13;&#10;&#13;&#10;&#13;&#10;//first step&#13;&#10;[invoice_date]&lt;TODAY() //not be in future (and not today)&#13;&#10;&#13;&#10;//second: only LY and CY&#13;&#10;and (&#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())&#13;&#10;        OR &#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())-1&#13;&#10;    )&#13;&#10;&#13;&#10;//third: yesterday only when there is certain sales sales data&#13;&#10;and if [invoice_date] = TODAY()-1&#13;&#10;    then &#13;&#10;        abs([turnover])&gt;0 //if data is not yet refreshed in GBQ, then I don&apos;t want that date&#13;&#10;        and [customer_sales_business_unit] in (&apos;Netherlands&apos;,&apos;Denmark&apos;) //sometimes INDI is there already with only 7 euros. So if NL is ready, probably all countries are ready. There is no RLS so it will not harm.&#13;&#10;    else true &#13;&#10;    end' />
            </column>
            <column caption='pm date feed real (2)' datatype='date' name='[Calculation_1813824758941749326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if &#13;&#10;//1=1&#13;&#10;[Calculation_1813824758940864589] &#13;&#10;then [invoice_date] end&#13;&#10;//second step' />
            </column>
            <column caption='date last year' datatype='date' datatype-customized='true' name='[Calculation_1813824758947549270]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if MONTH([Parameters].[Parameter 1])=2 and day([Parameters].[Parameter 1])=28 and [Calculation_1918533485506887680] //year([pm_date])=2025 &#13;&#10;then DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) +1 //1 day every 4 years needed. The year after the leap year on last day of feb&#13;&#10;else DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) //normal situation&#13;&#10;end' />
            </column>
            <column caption='Turnover Eur' datatype='real' name='[Calculation_1813824758949527643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Turnover base]&#13;&#10;else [Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[turnover_euro]' />
            </column>
            <column caption='Turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1813824758949773404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Margin % CY' datatype='real' default-format='p0.0%' name='[Calculation_1813824758953439329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CGS choosen CY (copy)_1813824758951571552])&#13;&#10;/&#13;&#10;sum([Calculation_1813824758949773404])' />
            </column>
            <column caption='ind_year_after_leap_year' datatype='boolean' name='[Calculation_1918533485506887680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*&#13;&#10;first line of code:&#13;&#10;2024 = 0&#13;&#10;2025 = 1 (because 20254/4 = 506.25 (so 1 is left and 1/4 = 0.25)&#13;&#10;2026 = 2&#13;&#10;2027 = 3&#13;&#10;2028 = 0&#13;&#10;*/&#13;&#10;&#13;&#10;year([Parameters].[Parameter 1])%4 &#13;&#10;= 1' />
            </column>
            <column caption='max_InvoiceDate LoD in order to feed default pm value' datatype='date' name='[Calculation_220394916815290368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(if [turnover_euro]&gt;0 and [invoice_date]&lt;=[Calculation_328199863975997441]-1 then [invoice_date] end)}&#13;&#10;//in order to feed the &quot;default pm value&quot;&#13;&#10;//daan: houdt geen rekening met verschillende BU&apos;s. Wellicht geen probleem. Voorbeeld: het is maandag. Er is 1 CSBU die gisteren&#13;&#10;//op zondag iets verkocht heeft. Dan is de default selectie zondag voor iedereen.&#13;&#10;//wil je graag t/m zaterdag kijken, dan pas je hem gewoon aan.' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='today()' />
            </column>
            <column caption='ind_CY QTD' datatype='boolean' name='[Calculation_4051550864659570688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_LY QTD' datatype='boolean' name='[Calculation_4051550864660381697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='Margin LY' datatype='real' name='[Margin choosen CY (copy)_1195142760560619536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_LY (rel) (copy)_236720504437403660] then [Calculation_1372190548006633472] end' />
            </column>
            <column caption='Turnover Budget Eur' datatype='real' name='[Turnover (copy)_1754433544814776320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Budget Turnover]&#13;&#10;else [Budget Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[budget_turnover_euro]' />
            </column>
            <column caption='Margin Budget' datatype='real' hidden='true' name='[Turnover Budget (copy)_1754433544820203523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Budget Margin]&#13;&#10;else [Budget Margin Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[budget_margin_euro]' />
            </column>
            <column caption='Margin Budget CY' datatype='real' name='[Turnover Budget CY (copy)_1754433544820387844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Turnover Budget (copy)_1754433544820203523] end' />
            </column>
            <column caption='Turnover LY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Turnover CY (copy)_1195142760512356366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_LY (rel) (copy)_236720504437403660] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Turnover Budget CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Turnover CY (copy)_1754433544815513601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Turnover (copy)_1754433544814776320] end' />
            </column>
            <column caption='Budget Margin Euro' datatype='real' name='[budget_margin_euro]' role='measure' type='quantitative' />
            <column caption='Budget Turnover Euro' datatype='real' name='[budget_turnover_euro]' role='measure' type='quantitative' />
            <column caption='Business Type' datatype='string' name='[business_type]' role='dimension' type='nominal' />
            <column caption='Business Type Group 1' datatype='string' name='[business_type_group_1]' role='dimension' type='nominal' />
            <column caption='Business Type Group 2' datatype='string' name='[business_type_group_2]' role='dimension' type='nominal' />
            <column caption='Cluster' datatype='string' name='[cluster]' role='dimension' type='nominal' />
            <column caption='Company Group' datatype='string' name='[company_group]' role='dimension' type='nominal' />
            <column caption='Csbu Country Join' datatype='string' name='[csbu_country_join]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Csbu Country Reporting' datatype='string' name='[csbu_country_reporting]' role='dimension' semantic-role='' type='nominal' />
            <column caption='Customer Sales Business Unit' datatype='string' name='[customer_sales_business_unit]' role='dimension' type='nominal' />
            <column caption='Date Full' datatype='date' name='[date_full]' role='dimension' type='ordinal' />
            <column caption='ind_CY' datatype='boolean' name='[ind_CY (rel) (copy)_236720504437403659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then [ind_CY MTD (rel) (copy)_236720504437403658]&#13;&#10;elseif [Parameters].[Parameter 2]=2 then [ind_CY YTD (rel) (copy)_236720504437403662]&#13;&#10;elseif [Parameters].[Parameter 2]=3 then [ind_CY_last 7 days (rel) (copy)_236720504437403661]&#13;&#10;elseif [Parameters].[Parameter 2]=4 then [ind_CY_last 28 days (rel) (copy)_236720504437403666]&#13;&#10;elseif [Parameters].[Parameter 2]=5 then [ind_CY_yesterday (rel) (copy)_236720504437403667]&#13;&#10;elseif [Parameters].[Parameter 2]=6 then [ind_CY_yesterday (copy)_837669592080760835]&#13;&#10;elseif [Parameters].[Parameter 2]=7 then [ind_CY MTD (copy)_1908681827015770114]&#13;&#10;elseif [Parameters].[Parameter 2]=8 then [ind_CY Full month (copy)_1352205831376080896]&#13;&#10;elseif [Parameters].[Parameter 2]=9 then [Calculation_4051550864659570688]&#13;&#10;end' />
            </column>
            <column caption='ind_CY Full Year' datatype='boolean' hidden='true' name='[ind_CY Full month (copy)_1352205831376080896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year([Calculation_1567252717417353216]) = year([Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_CY Full month' datatype='boolean' name='[ind_CY MTD (copy)_1908681827015770114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[Parameter 1])) &#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_CY MTD' datatype='boolean' name='[ind_CY MTD (rel) (copy)_236720504437403658]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_CY YTD' datatype='boolean' name='[ind_CY YTD (rel) (copy)_236720504437403662]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_CY_last 28 days' datatype='boolean' hidden='true' name='[ind_CY_last 28 days (rel) (copy)_236720504437403666]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]-27' />
            </column>
            <column caption='ind_CY_last 7 days' datatype='boolean' hidden='true' name='[ind_CY_last 7 days (rel) (copy)_236720504437403661]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and&#13;&#10;[Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]-6' />
            </column>
            <column caption='ind_CY_LTM' datatype='boolean' name='[ind_CY_yesterday (copy)_837669592080760835]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//also current month&#13;&#10;&#13;&#10;//[Invoice Date]&gt;[pm_date] - 365 //1. original version A&#13;&#10;[Calculation_1567252717417353216]&gt;[Parameters].[Parameter 1] - 365 //3. new version C because of mail from Schepers 28-8-2025&#13;&#10;//[Date per CSBU]&gt;[pm_date] - 364 //2. new version B, see mail to Steffen 21st of sept 2023&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]' />
            </column>
            <column caption='ind_CY_yesterday' datatype='boolean' hidden='true' name='[ind_CY_yesterday (rel) (copy)_236720504437403667]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]' />
            </column>
            <column caption='ind_LY' datatype='boolean' name='[ind_LY (rel) (copy)_236720504437403660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then [ind_LY MTD (rel) (copy)_236720504437403663]&#13;&#10;elseif [Parameters].[Parameter 2]=2 then [ind_LY YTD (rel) (copy)_236720504437403664]&#13;&#10;elseif [Parameters].[Parameter 2]=3 then [ind_LY_last 7 days (rel) (copy)_236720504437403665]&#13;&#10;elseif [Parameters].[Parameter 2]=4 then [ind_LY_last 28 days (rel) (copy)_236720504437403669]&#13;&#10;elseif [Parameters].[Parameter 2]=5 then [ind_LY_yesterday (rel) (copy)_236720504437403668]&#13;&#10;elseif [Parameters].[Parameter 2]=6 then [ind_LY_last 7 days (copy)_837669592102621188]&#13;&#10;elseif [Parameters].[Parameter 2]=7 then [ind_LY MTD (copy)_1908681827018035203]&#13;&#10;elseif [Parameters].[Parameter 2]=8 then [ind_LY Full Month (copy)_1352205831377436673]&#13;&#10;elseif [Parameters].[Parameter 2]=9 then [Calculation_4051550864660381697]&#13;&#10;else false&#13;&#10;end' />
            </column>
            <column caption='ind_LY Full Year' datatype='boolean' hidden='true' name='[ind_LY Full Month (copy)_1352205831377436673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year([Calculation_1567252717417353216]) = year([Parameters].[Parameter 1]) - 1' />
            </column>
            <column caption='ind_LY Full Month' datatype='boolean' hidden='true' name='[ind_LY MTD (copy)_1908681827018035203]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Calculation_1813824758947549270])) &#13;&#10;and [Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;month&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='ind_LY MTD' datatype='boolean' name='[ind_LY MTD (rel) (copy)_236720504437403663]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;month&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='ind_LY YTD' datatype='boolean' name='[ind_LY YTD (rel) (copy)_236720504437403664]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;year&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='ind_LY_last 28 days' datatype='boolean' hidden='true' name='[ind_LY_last 28 days (rel) (copy)_236720504437403669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#13;&#10;    and [Calculation_1567252717417353216]&gt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]-27)' />
            </column>
            <column caption='ind_LY_LTM' datatype='boolean' name='[ind_LY_last 7 days (copy)_837669592102621188]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#13;&#10;    and &#13;&#10;//[Date per CSBU]&gt;=DATEADD(&apos;year&apos;,-1,[pm_date]-363) //new version, it was 364&#13;&#10;[Calculation_1567252717417353216]&gt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]-364) // 29-8-2025 new new version, again to 364 becasue of mail from Schepers' />
            </column>
            <column caption='ind_LY_last 7 days' datatype='boolean' hidden='true' name='[ind_LY_last 7 days (rel) (copy)_236720504437403665]' role='dimension' type='nominal'>
