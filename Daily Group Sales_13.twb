            </column>
            <column caption='ind_LY (L4L)' datatype='boolean' hidden='true' name='[ind_LY (copy)_413205315851259909]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then [ind_LY MTD (copy)_413205315853545479]&#13;&#10;elseif [Parameters].[Parameter 2]=2 then [ind_LY YTD (copy)_413205315854385160]&#13;&#10;elseif [Parameters].[Parameter 2]=3 then [ind_LY_last 7 days (copy)_413205315850694659]&#13;&#10;elseif [Parameters].[Parameter 2]=4 then [ind_LY_last 28 days (copy)_413205315852808198]&#13;&#10;elseif [Parameters].[Parameter 2]=5 then [ind_LY_yesterday (rel) (copy)_236720504437403668]&#13;&#10;elseif [Parameters].[Parameter 2]=6 then [ind_LY YTD (L4L) (copy)_1488158205152288768] //added this one&#13;&#10;elseif [Parameters].[Parameter 2]=7 then [ind_LY MTD (L4L) (copy)_1908681827021164548]&#13;&#10;elseif [Parameters].[Parameter 2]=8 then [ind_LY Full Month (L4L) (copy)_1352205831482003458]&#13;&#10;else false&#13;&#10;end' />
            </column>
            <column caption='ind_LY Full Year (L4L)' datatype='boolean' hidden='true' name='[ind_LY Full Month (L4L) (copy)_1352205831482003458]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// 2 jan last year  until 1 jan&#13;&#10;&#13;&#10;[Calculation_1567252717417353216]&lt;=datetrunc(&apos;year&apos;,[Parameters].[Parameter 1])&#13;&#10;&#13;&#10;    and [Calculation_1567252717417353216]&gt;=datetrunc(&apos;year&apos;,DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]))+1 //2 jan last year' />
            </column>
            <column caption='ind_LY Full Month (L4L)' datatype='boolean' hidden='true' name='[ind_LY MTD (L4L) (copy)_1908681827021164548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//[Invoice Date]&lt;=[date last year]&#13;&#10;//and &#13;&#10;//[Invoice Date]&gt;=DATETRUNC(&apos;month&apos;,[date last year])&#13;&#10;&#13;&#10;[Calculation_1567252717417353216]&lt;=datetrunc(&apos;month&apos;,dateadd(&apos;month&apos;,1,[Parameters].[Parameter 1]))-365&#13;&#10;&#13;&#10;    and [Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]-364-day([Parameters].[Parameter 1])+1' />
            </column>
            <column caption='ind_LY MTD (L4L)' datatype='boolean' hidden='true' name='[ind_LY MTD (copy)_413205315853545479]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//[Invoice Date]&lt;=[date last year]&#13;&#10;//and &#13;&#10;//[Invoice Date]&gt;=DATETRUNC(&apos;month&apos;,[date last year])&#13;&#10;&#13;&#10;[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]-364&#13;&#10;    and [Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]-364-day([Parameters].[Parameter 1])+1' />
            </column>
            <column caption='ind_LY_LTM (L4L)' datatype='boolean' hidden='true' name='[ind_LY YTD (L4L) (copy)_1488158205152288768]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]-364&#13;&#10;&#13;&#10;and [Calculation_1567252717417353216]&gt;=[Parameters].[Parameter 1]-364-365' />
            </column>
            <column caption='ind_LY YTD (L4L)' datatype='boolean' hidden='true' name='[ind_LY YTD (copy)_413205315854385160]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//[Invoice Date]&lt;=[date last year]&#13;&#10;//and &#13;&#10;//[Invoice Date]&gt;=DATETRUNC(&apos;year&apos;,[date last year])&#13;&#10;&#13;&#10;&#13;&#10;[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]-364&#13;&#10;    and [Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;year&apos;,dateadd(&apos;year&apos;,-1,[Parameters].[Parameter 1]))+1 //bigger than first date of the previous year' />
            </column>
