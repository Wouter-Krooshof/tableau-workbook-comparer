    <worksheet name='highlight table 1 CSBU prod cat'>
      <table>
        <view>
          <datasources>
            <datasource caption='Daily Group Sales 3.0' name='federated.07pdzlx0k2seif18uh2zd1jwbeij' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='pm_date' datatype='date' default-value-field='[federated.07pdzlx0k2seif18uh2zd1jwbeij].[Calculation_220394916815290368]' name='[Parameter 1]' param-domain-type='list' role='measure' source-field='[federated.07pdzlx0k2seif18uh2zd1jwbeij].[Calculation_1813824758941749326]' type='quantitative' value='#2026-09-23#'>
              <calculation class='tableau' formula='#2026-09-23#' />
            </column>
            <column alias='MTD' caption='pm_MTD_YTD_L7Days_etc' datatype='real' name='[Parameter 2]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='MTD' />
                <alias key='2.' value='YTD' />
                <alias key='3.' value='Last 7 calendar days' />
                <alias key='4.' value='Last 28 calendar days' />
                <alias key='5.' value='1 date (L4L)' />
                <alias key='6.' value='LTM' />
                <alias key='7.' value='Full Month (incl. future)' />
                <alias key='8.' value='Full Year (incl. future)' />
                <alias key='9.' value='QTD' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.07pdzlx0k2seif18uh2zd1jwbeij'>
            <column caption='# invoicing days LY' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# invoicing days CY (copy)_1766818465106362372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;//for the colofon, do it per year&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_LY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [SalesBusinessUnit]: sum(if 1=1 and [ind_LY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)] end)})&#13;&#10;avg({FIXED [csbu_country_join (pres__obt__csbucountry_invoicing_dates)]: &#13;&#10;sum(if 1=1 and [ind_LY (rel) (copy)_236720504437403660] then [invoice_day (pres__obt__csbucountry_invoicing_dates)] end)})' />
            </column>
            <column caption='% Turnover CY vs LY' datatype='real' default-format='p0.0%' name='[% Turnover CY vs comparison (copy)_1372190548062879754]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1813824758949773404]) - sum([Turnover CY (copy)_1195142760512356366]))&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1195142760512356366])' />
            </column>
            <column caption='% Daily average Orderlines CY vs LY' datatype='real' default-format='p0.0%' name='[% Turnover CY vs comparison (copy)_1766818465109512199 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1766818465106001922 1] - [Daily average turnover CY  (copy)_1766818465106255875 1])&#13;&#10;/&#13;&#10;[Daily average turnover CY  (copy)_1766818465106255875 1]' />
            </column>
            <column caption='% Daily average turnover CY vs LY' datatype='real' default-format='p0.0%' name='[% Turnover CY vs comparison (copy)_1766818465109512199]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1766818465106001922] - [Daily average turnover CY  (copy)_1766818465106255875])&#13;&#10;/&#13;&#10;[Daily average turnover CY  (copy)_1766818465106255875]' />
            </column>
            <column caption='% margin CY vs LY pp' datatype='real' default-format='*#,##0.0 pp;-#,##0.0 pp' name='[% margin CY vs comparison pp (copy)_245164741970182144]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1813824758953439329] - [Calculation_1372190548008853507]) *100&#13;&#10;//daan: pp because percentage point difference' />
            </column>
            <column caption='Business Type Group' datatype='string' name='[Business Type Group 2 (copy)_1386545745140359168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// business type group 2 but then only for title of the tables&#13;&#10;[business_type_group_2]' />
            </column>
            <column caption='Margin CY' datatype='real' name='[CGS choosen CY (copy)_1813824758951571552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548006633472] end' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [source]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;     when  &apos;ProductCategoryBudget_Rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
            </column>
            <column caption='Margin Eur' datatype='real' hidden='true' name='[Calculation_1372190548006633472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[margin_euro]&#13;&#10;//makes it easier to copy paste formulas from sales nordics' />
            </column>
            <column caption='Margin % LY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008853507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Margin choosen CY (copy)_1195142760560619536])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1195142760512356366])' />
            </column>
            <column caption='# Orderlines normal' datatype='real' name='[Calculation_1372190548022374405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1456914503679799305]' />
            </column>
            <column caption='# Orderlines' datatype='real' name='[Calculation_1456914503679799305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//zn([NumberOfOrderlines_EDI]) + zn([NumberOfOrderlines_Manual]) + zn([NumberOfOrderlines_Webshop])&#13;&#10;zn([number_of_orderlines_edi]) + zn([number_of_orderlines_manual]) + zn([number_of_orderlines_webshop])' />
            </column>
            <column caption='Turnover Budget Category CY' datatype='real' name='[Calculation_1546773406101504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [category_budget_turnover_euro] end' />
            </column>
            <column caption='% Turnover CY vs Category budget' datatype='real' name='[Calculation_1546773406638081]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1813824758949773404]) - sum([Calculation_1546773406101504]))&#13;&#10;/&#13;&#10;sum([Calculation_1546773406101504])' />
            </column>
            <column caption='Turnover &amp; Budget Filter (category)' datatype='boolean' name='[Calculation_1546773406986242]' role='measure' type='nominal'>
              <calculation class='tableau' formula='// WK: set filter == false to exclude not needed rows &#13;&#10;ISNULL(SUM([Calculation_1813824758949773404])) and ISNULL(sum([Calculation_1546773406101504]))' />
            </column>
            <column caption='Date per CSBU' datatype='date' name='[Calculation_1567252717417353216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//daan: handy to have a field in beteween. With this 1 I can - for test purposes - swith between the 2 date fields.&#13;&#10;//[Invoice Date]        //coming from hte big TO table&#13;&#10;//[dateFull (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]             //coming from the small dates table&#13;&#10;[date_full]' />
            </column>
            <column caption='# invoicing days CY' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818465105641473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;&#13;&#10;//difficult to fix this with 1 table, therefore I changed it, now I am using 2 tables in this workbook / data source&#13;&#10;//the second table: 1 record per CSBU per date. Therefore, much easier.&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_CY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [Sales Business Unit]: sum(if 1=1 and [ind_CY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;avg({FIXED [csbu_country_join (pres__obt__csbucountry_invoicing_dates)]: &#13;&#10;sum(if 1=1 and [ind_CY (rel) (copy)_236720504437403659] then [invoice_day (pres__obt__csbucountry_invoicing_dates)] end)})' />
            </column>
            <column caption='Daily average # Orderlines CY' datatype='real' name='[Calculation_1766818465106001922 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1813824758949773404 1])&#13;&#10;/ &#13;&#10;[Calculation_1766818465105641473]' />
            </column>
            <column caption='Daily average turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1766818465106001922]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1813824758949773404])&#13;&#10;/ &#13;&#10;[Calculation_1766818465105641473]' />
            </column>
            <column caption='pm date feed ind (1)' datatype='boolean' name='[Calculation_1813824758940864589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//the goal: show all dates before today, but be carefull with yesterday. Yesterday should only be there if there is salesdata.&#13;&#10;&#13;&#10;&#13;&#10;//first step&#13;&#10;[invoice_date]&lt;TODAY() //not be in future (and not today)&#13;&#10;&#13;&#10;//second: only LY and CY&#13;&#10;and (&#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())&#13;&#10;        OR &#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())-1&#13;&#10;    )&#13;&#10;&#13;&#10;//third: yesterday only when there is certain sales sales data&#13;&#10;and if [invoice_date] = TODAY()-1&#13;&#10;    then &#13;&#10;        abs([turnover])&gt;0 //if data is not yet refreshed in GBQ, then I don&apos;t want that date&#13;&#10;        and [customer_sales_business_unit] in (&apos;Netherlands&apos;,&apos;Denmark&apos;) //sometimes INDI is there already with only 7 euros. So if NL is ready, probably all countries are ready. There is no RLS so it will not harm.&#13;&#10;    else true &#13;&#10;    end' />
            </column>
            <column caption='pm date feed real (2)' datatype='date' name='[Calculation_1813824758941749326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if &#13;&#10;//1=1&#13;&#10;[Calculation_1813824758940864589] &#13;&#10;then [invoice_date] end&#13;&#10;//second step' />
            </column>
            <column caption='date last year' datatype='date' datatype-customized='true' name='[Calculation_1813824758947549270]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if MONTH([Parameters].[Parameter 1])=2 and day([Parameters].[Parameter 1])=28 and [Calculation_1918533485506887680] //year([pm_date])=2025 &#13;&#10;then DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) +1 //1 day every 4 years needed. The year after the leap year on last day of feb&#13;&#10;else DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) //normal situation&#13;&#10;end' />
            </column>
            <column caption='Turnover Eur' datatype='real' name='[Calculation_1813824758949527643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Turnover base]&#13;&#10;else [Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[turnover_euro]' />
            </column>
            <column caption='# Orderlines CY' datatype='real' name='[Calculation_1813824758949773404 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548022374405] end' />
            </column>
            <column caption='Turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1813824758949773404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Margin % CY' datatype='real' default-format='p0.0%' name='[Calculation_1813824758953439329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CGS choosen CY (copy)_1813824758951571552])&#13;&#10;/&#13;&#10;sum([Calculation_1813824758949773404])' />
            </column>
            <column caption='ind_year_after_leap_year' datatype='boolean' name='[Calculation_1918533485506887680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*&#13;&#10;first line of code:&#13;&#10;2024 = 0&#13;&#10;2025 = 1 (because 20254/4 = 506.25 (so 1 is left and 1/4 = 0.25)&#13;&#10;2026 = 2&#13;&#10;2027 = 3&#13;&#10;2028 = 0&#13;&#10;*/&#13;&#10;&#13;&#10;year([Parameters].[Parameter 1])%4 &#13;&#10;= 1' />
            </column>
            <column caption='max_InvoiceDate LoD in order to feed default pm value' datatype='date' name='[Calculation_220394916815290368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(if [turnover_euro]&gt;0 and [invoice_date]&lt;=[Calculation_328199863975997441]-1 then [invoice_date] end)}&#13;&#10;//in order to feed the &quot;default pm value&quot;&#13;&#10;//daan: houdt geen rekening met verschillende BU&apos;s. Wellicht geen probleem. Voorbeeld: het is maandag. Er is 1 CSBU die gisteren&#13;&#10;//op zondag iets verkocht heeft. Dan is de default selectie zondag voor iedereen.&#13;&#10;//wil je graag t/m zaterdag kijken, dan pas je hem gewoon aan.' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='today()' />
            </column>
            <column caption='ind_CY QTD' datatype='boolean' name='[Calculation_4051550864659570688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])' />
            </column>
