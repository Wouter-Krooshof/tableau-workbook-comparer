        <calculation class='tableau' formula='//if [ind_CY YTD] then [Turnover Eur] end&#13;&#10;&#13;&#10;//WK: only want to show rows with turnover or contingency rows &#13;&#10;&#13;&#10;IF [Calculation_1813824758949773404] &lt;&gt; 0 &#13;&#10;OR &#13;&#10;CONTAINS(lower([csbu_country_reporting]), &apos;contingency&apos;)&#13;&#10;THEN TRUE ELSE FALSE END' />
