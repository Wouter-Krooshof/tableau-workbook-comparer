              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;year&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='ind_LY_last 28 days' datatype='boolean' hidden='true' name='[ind_LY_last 28 days (rel) (copy)_236720504437403669]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])&#13;&#10;    and [Calculation_1567252717417353216]&gt;=DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1]-27)' />
