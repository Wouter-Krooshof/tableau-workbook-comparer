            <column caption='ind_only_full_months' datatype='boolean' name='[ind_remove_future (copy)_1778640394307944453]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[invoice_date]&lt;DATETRUNC(&apos;month&apos;,TODAY()-1)' />
