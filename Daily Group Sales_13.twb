      <column caption='Business Type Group' datatype='string' name='[Business Type Group 2 (copy)_1386545745140359168]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// business type group 2 but then only for title of the tables&#13;&#10;[business_type_group_2]' />
      </column>
      <column caption='Margin CY' datatype='real' name='[CGS choosen CY (copy)_1813824758951571552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548006633472] end' />
      </column>
      <column caption='_LY: first date' datatype='datetime' datatype-customized='true' default-format='*d mmmm &apos;yy' name='[CY: first date (copy)_1344324499169861633]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//pretty fast because only pm :)&#13;&#10;//goal: feed header with info about selection period (for printing purposes)&#13;&#10;/*&#13;&#10;date(&#13;&#10;        &#13;&#10;            if [pm_MTD_YTD]=1 then DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;month&apos;,[pm_date])) &#13;&#10;            elseif [pm_MTD_YTD]=2 then DATEADD(&apos;year&apos;,-1,DATETRUNC(&apos;year&apos;,[pm_date]))&#13;&#10;            elseif [pm_MTD_YTD]=3 then DATEADD(&apos;year&apos;,-1,[pm_date]-6)&#13;&#10;            elseif [pm_MTD_YTD]=4 then DATEADD(&apos;year&apos;,-1,[pm_date]-27)&#13;&#10;            //elseif [pm_MTD_YTD]=5 then DATEADD(&apos;year&apos;,-1,[pm_date])&#13;&#10;            end&#13;&#10;        &#13;&#10;)&#13;&#10;*/&#13;&#10;&#13;&#10;if  [Parameters].[Parameter 2]&lt;&gt;5 //not only 1 day&#13;&#10;    then dateadd(&apos;year&apos;,-1,[Calculation_1344324499169132544])&#13;&#10;    elseif [Parameters].[Parameter 2]=5 then [Calculation_1344324499169132544]-364 //compare with last year, only 1 date: then there is nothing to compare with&#13;&#10;    &#13;&#10;end' />
      </column>
      <column caption='Sales region' datatype='string' name='[Calculation_1051872033104461825]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//daan: in the old solution this was a group. I prefer a calculated field because it is more clear how it works.&#13;&#10;if [customer_sales_business_unit] = &apos;Agerpol&apos;                   then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Austria&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Baltics&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Belgium&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Bulgaria&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Croatia and Slovenia&apos;  then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Czech Republic&apos;        then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Denmark&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export ROW&apos;            then &apos;ROW&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Export SEE&apos;            then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Finland&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;France&apos;                then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Germany&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Grene Retail&apos;          then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Hungary&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;INDI&apos;                  then &apos;INDI&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Italy&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Netherlands&apos;           then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Norway&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland&apos;                then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Poland Franchise&apos;      then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Raico&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Recinsa&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Republic of Ireland&apos;   then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Romania&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Russia&apos;                then &apos;Russia&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Slovakia&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Spain&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Sweden&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Switzerland&apos;           then &apos;2- South West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;Ukraine&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;United Kingdom&apos;        then &apos;1 - North West&apos;&#13;&#10;elseif [customer_sales_business_unit] = &apos;UK &amp; Ireland&apos;          then &apos;1 - North West&apos;   //Daan: added this one&#13;&#10;elseif [customer_sales_business_unit] = &apos;Tehnikakeskus&apos;          then &apos;3 - East&apos;        //Daan: added this one&#13;&#10;end' />
        <desc>
          <formatted-text>
            <run>coming from CSBU</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Turnover &amp; Budget Filter' datatype='boolean' name='[Calculation_1143351387792154625]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// WK: set filter == false to exclude not needed rows &#13;&#10;ISNULL(SUM([Calculation_1813824758949773404])) and ISNULL(sum([Turnover CY (copy)_1754433544815513601]))' />
      </column>
      <column caption='Normalized Δ Turnover' datatype='real' name='[Calculation_1188387406339723265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// WK: Used to color Table Business Type vs. Industry &#13;&#10;// Reason for this method: We want a color on turnover vs ly (ABS) which works well when switching between periods (MTD, YTD etc.) &#13;&#10;// Formula: We take the delta turnover from an individual industry / business type and compare it to the totall. &#13;&#10;// It is important to check &apos;compute using&apos; when you are using ths QTC. &#13;&#10;&#13;&#10;//[Turnover CY -/- LY] / ABS(WINDOW_SUM([Turnover CY -/- LY]))&#13;&#10;&#13;&#10;// some examples &#13;&#10;// delta = +4 &amp; total = +100 --&gt; 4/100 = +4% == Green &#13;&#10;// delta = +4 &amp; total = -100 --&gt; 4/100 = +4% == Geen  &#13;&#10;&#13;&#10;[% Turnover CY vs LY (copy 2)_1615103459570651136] / WINDOW_SUM(sum([Calculation_1813824758949773404]))&#13;&#10;&#13;&#10;// decided to divide by the sum of turnover to overcome problem with small delta&apos;s'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='_CY: first date' datatype='date' datatype-customized='true' default-format='*d mmmm &apos;yy' name='[Calculation_1344324499169132544]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//pretty fast because only pm :)&#13;&#10;//goal: feed header with info about selection period (for printing purposes)&#13;&#10;date(&#13;&#10;        if [Parameters].[Parameter 2]=1 then DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])          //1.MTD&#13;&#10;        elseif [Parameters].[Parameter 2]=2 then DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])       //2. YTD&#13;&#10;        elseif [Parameters].[Parameter 2]=3 then [Parameters].[Parameter 1]-6                       //3. Last 7 days&#13;&#10;        elseif [Parameters].[Parameter 2]=4 then [Parameters].[Parameter 1]-27                      //4. Last 28 days&#13;&#10;        elseif [Parameters].[Parameter 2]=5 then [Parameters].[Parameter 1]                         //5. 1 day&#13;&#10;        elseif [Parameters].[Parameter 2]=6 then [Parameters].[Parameter 1]-364                     //6. L12M //29-8-2025 364, it was 363.&#13;&#10;        elseif [Parameters].[Parameter 2]=7 then DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])      //7. Full month&#13;&#10;        elseif [Parameters].[Parameter 2]=8 then DATETRUNC(&apos;year&apos;,[Parameters].[Parameter 1])       //8. Full Year&#13;&#10;        elseif [Parameters].[Parameter 2]=9 then DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])    //9. QTD&#13;&#10;        end&#13;&#10;)' />
      </column>
      <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [source]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;     when  &apos;ProductCategoryBudget_Rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
      </column>
      <column caption='Margin Eur' datatype='real' hidden='true' name='[Calculation_1372190548006633472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[margin_euro]&#13;&#10;//makes it easier to copy paste formulas from sales nordics' />
      </column>
      <column caption='Margin % budget CY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008140802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Turnover Budget CY (copy)_1754433544820387844])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])' />
      </column>
      <column caption='Margin % LY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008853507]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Margin choosen CY (copy)_1195142760560619536])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1195142760512356366])' />
      </column>
      <column caption='# Orderlines normal' datatype='real' name='[Calculation_1372190548022374405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1456914503679799305]' />
      </column>
      <column caption='Daily avg turnover delta last year (for small multiples)' datatype='real' default-format='p0.0%' name='[Calculation_1410752630613745666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Daily average turnover CY (copy)_1410752630609850368]) - LOOKUP(ZN([Daily average turnover CY (copy)_1410752630609850368]), -12)) &#13;&#10;/ &#13;&#10;ABS(LOOKUP(ZN([Daily average turnover CY (copy)_1410752630609850368]), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ind_years_small_multiples' datatype='boolean' name='[Calculation_1410752630617067524]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 3] = 5 then true&#13;&#10;elseif [Parameters].[Parameter 3] = 3 and year([Calculation_328199863975997441]) - year([invoice_date]) &lt; 3 then true //2025 - 2023&#13;&#10;elseif [Parameters].[Parameter 3] = 2 and year([Calculation_328199863975997441]) - year([invoice_date]) &lt; 2 then true //2025 - 2023&#13;&#10;end' />
      </column>
      <column caption='% Turnover CY vs budget copy' datatype='real' default-format='p0.0%' name='[Calculation_1423137524799574016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Turnover CY vs comparison (copy) (copy)_1372190548062892043]&#13;&#10;//daan: I want another alias, therefore duplicate this field' />
      </column>
      <column caption='# Orderlines' datatype='real' name='[Calculation_1456914503679799305]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//zn([NumberOfOrderlines_EDI]) + zn([NumberOfOrderlines_Manual]) + zn([NumberOfOrderlines_Webshop])&#13;&#10;zn([number_of_orderlines_edi]) + zn([number_of_orderlines_manual]) + zn([number_of_orderlines_webshop])' />
      </column>
      <column caption='index()' datatype='integer' name='[Calculation_1480839898648948739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='index()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Turnover Budget Category CY' datatype='real' name='[Calculation_1546773406101504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [category_budget_turnover_euro] end' />
      </column>
      <column caption='% Turnover CY vs Category budget' datatype='real' name='[Calculation_1546773406638081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Calculation_1813824758949773404]) - sum([Calculation_1546773406101504]))&#13;&#10;/&#13;&#10;sum([Calculation_1546773406101504])' />
      </column>
      <column caption='Turnover &amp; Budget Filter (category)' datatype='boolean' name='[Calculation_1546773406986242]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// WK: set filter == false to exclude not needed rows &#13;&#10;ISNULL(SUM([Calculation_1813824758949773404])) and ISNULL(sum([Calculation_1546773406101504]))' />
      </column>
      <column caption='% Turnover lc CY vs category budget' datatype='real' name='[Calculation_1546773410091012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(sum([Turnover CY (copy)_1698138576716890112]) - sum([Calculation_1546773410177029]))&#13;&#10;/&#13;&#10;sum([Calculation_1546773410177029])' />
      </column>
      <column caption='Turnover lc Budget Category CY' datatype='real' name='[Calculation_1546773410177029]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [category_budget_turnover] end' />
      </column>
      <column caption='Turnover &amp; Cat. Budget LC not null' datatype='boolean' name='[Calculation_1546773410570246]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//WK&#13;&#10;//Used to filter out rows in segmentation &amp; category LC that only include null values &#13;&#10;ISNULL(sum([Turnover CY (copy)_1698138576716890112])) and ISNULL(sum([Calculation_1546773410177029]))' />
      </column>
      <column caption='Turnover &amp; Budget LC not null' datatype='boolean' name='[Calculation_1546773411348487]' role='measure' type='nominal'>
        <calculation class='tableau' formula='//WK&#13;&#10;//Used to filter out rows in segmentation &amp; category LC that only include null values &#13;&#10;ISNULL(sum([Turnover CY (copy)_1698138576716890112])) and ISNULL(sum([Turnover Budget CY (copy)_1698138576777445384]))' />
      </column>
      <column caption='Turnover Budget CY (Dynamic)' datatype='real' name='[Calculation_1546773412773896]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// dynamic so it takes cat. budgets when prod. categories are selected&#13;&#10;IF [Parameters].[pm_per what 2 (segment, product category,CSBU) (copy)_1173469180403781632] = 3 then [Calculation_1546773406101504]&#13;&#10;ELSE [Turnover CY (copy)_1754433544815513601] END' />
      </column>
      <column caption='% Turnover CY vs budget (dynamic)' datatype='real' name='[Calculation_1546773413240841]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[pm_per what 2 (segment, product category,CSBU) (copy)_1173469180403781632] = 3 THEN &#13;&#10;&#13;&#10;(sum([Calculation_1813824758949773404]) - sum([Calculation_1546773406101504]))&#13;&#10;/&#13;&#10;sum([Calculation_1546773406101504])&#13;&#10;&#13;&#10;&#13;&#10;ELSE &#13;&#10;(sum([Calculation_1813824758949773404]) - sum([Turnover CY (copy)_1754433544815513601]))&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])&#13;&#10;END' />
      </column>
      <column caption='Date per CSBU' datatype='date' name='[Calculation_1567252717417353216]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//daan: handy to have a field in beteween. With this 1 I can - for test purposes - swith between the 2 date fields.&#13;&#10;//[Invoice Date]        //coming from hte big TO table&#13;&#10;//[dateFull (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]             //coming from the small dates table&#13;&#10;[date_full]' />
      </column>
      <column caption='Max InvoiceDate on Invoice day and with Turnover' datatype='date' name='[Calculation_1613977551456641036]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='MAX(IF [turnover_euro]!=0 &#13;&#10;//AND [Invoiceday]=1  decided to comment this out because makes no sense&#13;&#10;THEN [invoice_date] END)' />
      </column>
      <column caption='Filter out CSBUs (detail Absolute)' datatype='boolean' name='[Calculation_1626925398090838016]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ISNULL(sum([Calculation_1813824758949773404])) and ISNULL(sum([Turnover CY (copy)_1195142760512356366])) and ISNULL(sum([Turnover CY (copy)_1754433544815513601]))' />
      </column>
      <column caption='Can see view filter' datatype='boolean' name='[Calculation_1691946118104207360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// lay out of the filter &quot;view&quot; -- control visibility using this filter&#13;&#10;// wk: to only display this filter to members of the contingency group&#13;&#10;ISMEMBEROF(&apos;DGS_budget_contingency&apos;)' />
      </column>
      <column caption='FX_LYDelta%' datatype='real' default-format='p0.0%' name='[Calculation_1698138576774520838]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[% Turnover CY vs comparison (copy)_1372190548062879754]-[% Turnover CY vs LY (copy)_1698138576716992514]' />
      </column>
      <column caption='FX' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[Calculation_1698138576781074443]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//sum([Turnover base])/sum([Turnover Eur])&#13;&#10;sum([Calculation_1813824758949527643]) / sum([turnover])' />
      </column>
      <column caption='# invoicing days CY' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818465105641473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;&#13;&#10;//difficult to fix this with 1 table, therefore I changed it, now I am using 2 tables in this workbook / data source&#13;&#10;//the second table: 1 record per CSBU per date. Therefore, much easier.&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_CY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [Sales Business Unit]: sum(if 1=1 and [ind_CY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;avg({FIXED [csbu_country_join (pres__obt__csbucountry_invoicing_dates)]: &#13;&#10;sum(if 1=1 and [ind_CY (rel) (copy)_236720504437403659] then [invoice_day (pres__obt__csbucountry_invoicing_dates)] end)})' />
      </column>
      <column caption='Daily average # Orderlines CY' datatype='real' name='[Calculation_1766818465106001922 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1813824758949773404 1])&#13;&#10;/ &#13;&#10;[Calculation_1766818465105641473]' />
      </column>
      <column caption='Daily average turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1766818465106001922]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Calculation_1813824758949773404])&#13;&#10;/ &#13;&#10;[Calculation_1766818465105641473]' />
      </column>
      <column caption='pm date feed ind (1)' datatype='boolean' name='[Calculation_1813824758940864589]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//the goal: show all dates before today, but be carefull with yesterday. Yesterday should only be there if there is salesdata.&#13;&#10;&#13;&#10;&#13;&#10;//first step&#13;&#10;[invoice_date]&lt;TODAY() //not be in future (and not today)&#13;&#10;&#13;&#10;//second: only LY and CY&#13;&#10;and (&#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())&#13;&#10;        OR &#13;&#10;        YEAR([invoice_date])=YEAR(TODAY())-1&#13;&#10;    )&#13;&#10;&#13;&#10;//third: yesterday only when there is certain sales sales data&#13;&#10;and if [invoice_date] = TODAY()-1&#13;&#10;    then &#13;&#10;        abs([turnover])&gt;0 //if data is not yet refreshed in GBQ, then I don&apos;t want that date&#13;&#10;        and [customer_sales_business_unit] in (&apos;Netherlands&apos;,&apos;Denmark&apos;) //sometimes INDI is there already with only 7 euros. So if NL is ready, probably all countries are ready. There is no RLS so it will not harm.&#13;&#10;    else true &#13;&#10;    end' />
      </column>
      <column caption='pm date feed real (2)' datatype='date' name='[Calculation_1813824758941749326]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if &#13;&#10;//1=1&#13;&#10;[Calculation_1813824758940864589] &#13;&#10;then [invoice_date] end&#13;&#10;//second step' />
      </column>
      <column caption='date last year' datatype='date' datatype-customized='true' name='[Calculation_1813824758947549270]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if MONTH([Parameters].[Parameter 1])=2 and day([Parameters].[Parameter 1])=28 and [Calculation_1918533485506887680] //year([pm_date])=2025 &#13;&#10;then DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) +1 //1 day every 4 years needed. The year after the leap year on last day of feb&#13;&#10;else DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) //normal situation&#13;&#10;end' />
      </column>
      <column caption='Turnover Eur' datatype='real' name='[Calculation_1813824758949527643]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Turnover base]&#13;&#10;else [Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[turnover_euro]' />
      </column>
      <column caption='# Orderlines CY' datatype='real' name='[Calculation_1813824758949773404 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548022374405] end' />
      </column>
      <column caption='Turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1813824758949773404]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1813824758949527643] end' />
      </column>
      <column caption='Margin % CY' datatype='real' default-format='p0.0%' name='[Calculation_1813824758953439329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([CGS choosen CY (copy)_1813824758951571552])&#13;&#10;/&#13;&#10;sum([Calculation_1813824758949773404])' />
      </column>
      <column caption='ind_year_after_leap_year' datatype='boolean' name='[Calculation_1918533485506887680]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='/*&#13;&#10;first line of code:&#13;&#10;2024 = 0&#13;&#10;2025 = 1 (because 20254/4 = 506.25 (so 1 is left and 1/4 = 0.25)&#13;&#10;2026 = 2&#13;&#10;2027 = 3&#13;&#10;2028 = 0&#13;&#10;*/&#13;&#10;&#13;&#10;year([Parameters].[Parameter 1])%4 &#13;&#10;= 1' />
      </column>
      <column caption='ind_month' datatype='boolean' name='[Calculation_1918533485510971394]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='MONTH([Parameters].[Parameter 1]) = month([Calculation_1567252717417353216])&#13;&#10;//daan: added because of leap year complexity. Used in daily full month tab.' />
      </column>
      <column caption='max_InvoiceDate LoD in order to feed default pm value' datatype='date' name='[Calculation_220394916815290368]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed: max(if [turnover_euro]&gt;0 and [invoice_date]&lt;=[Calculation_328199863975997441]-1 then [invoice_date] end)}&#13;&#10;//in order to feed the &quot;default pm value&quot;&#13;&#10;//daan: houdt geen rekening met verschillende BU&apos;s. Wellicht geen probleem. Voorbeeld: het is maandag. Er is 1 CSBU die gisteren&#13;&#10;//op zondag iets verkocht heeft. Dan is de default selectie zondag voor iedereen.&#13;&#10;//wil je graag t/m zaterdag kijken, dan pas je hem gewoon aan.' />
      </column>
      <column caption='Commerce score' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_245164741975162884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='/*&#13;&#10;daan: I would like to give CSBU&apos;s that have big negative delta&apos;s in multiple KPI&apos;s a big alert&#13;&#10; zn(if [% Turnover CY vs budget]    &lt;-0.15      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs budget]    &lt;-0.1      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs budget]    &lt;-0.05     then 0.5 end)&#13;&#10; &#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.15     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.1     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.05    then 0.5 end)&#13;&#10;&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.15   then 0.5 end)&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.1   then 0.5 end)&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.05  then 0.5 end)&#13;&#10;*/&#13;&#10;&#13;&#10;zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.15      then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.1      then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.05     then -0.5 end)&#13;&#10;&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-1.5     then -0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-1     then -0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-0.5    then -0.5 end)&#13;&#10;&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.15   then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.1   then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.05  then -0.5 end)&#13;&#10;&#13;&#10;///////////////////////////////////////////////////////////////////////////plus////////////////////////////////////////////////////////////////&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.15      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.1      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.05     then 0.5 end)&#13;&#10;&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;1.5     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;1     then 0.5 end) &#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;0.5    then 0.5 end) &#13;&#10;&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.15   then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.1   then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.05  then 0.5 end)' />
      </column>
      <column caption='day of week L4L tooltip' datatype='integer' name='[Calculation_2771402638455300096]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='[Calculation_413205315869618191]&#13;&#10;//long format' />
        <aliases>
          <alias key='1' value='Monday' />
          <alias key='2' value='Tuesday' />
          <alias key='3' value='Wednesday' />
          <alias key='4' value='Thursday' />
          <alias key='5' value='Friday' />
          <alias key='6' value='Saturday' />
          <alias key='7' value='Sunday' />
        </aliases>
      </column>
      <column caption='Yesterday or Friday (Input traffic light)' datatype='datetime' name='[Calculation_3175882162430353408]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//yesterday (or 2 days ago if today is Sunday or Monday)&#13;&#10;    DATEADD&#13;&#10;            (&apos;day&apos;&#13;&#10;            ,if DATEPART(&#13;&#10;                           &apos;weekday&apos;,TODAY()&#13;&#10;                        )&#13;&#10;                 //equals 1 means Sunday. If Sunday, then Friday because Saturday is always very late!?&#13;&#10;                 //equals 2 means Monday. If Monday, then Saturday because Sunday does not always have sales data.&#13;&#10;                in (1,2) then -2 &#13;&#10;                                    // *11/06/2024 update* because there were some wrong colors on sunday, we changed this part of the code from -3 to -2.&#13;&#10;                else -1 //else -1 so Yesterday.&#13;&#10;             END&#13;&#10;            ,[Calculation_328199863975997441]&#13;&#10;            )' />
      </column>
      <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='today()' />
      </column>
      <column caption='Daily Turnover (full month)' datatype='real' name='[Calculation_3638064100130344960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([turnover_euro])/[# invoicing days CY (copy)_5384053373403516930]' />
      </column>
      <column caption='% turnover vs budget cum' datatype='real' name='[Calculation_3836222468675207169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    RUNNING_SUM(SUM([turnover_euro])) - RUNNING_SUM(SUM([Turnover (copy)_1754433544814776320])) &#13;&#10;)&#13;&#10;/&#13;&#10;RUNNING_SUM(SUM([Turnover (copy)_1754433544814776320]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Turnover running sum' datatype='real' name='[Calculation_3836222468677021698]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//this is good, but not good enough. For future days, I don&apos;t want to see bars for turnover.&#13;&#10;//RUNNING_SUM(SUM([Turnover Euro]))&#13;&#10;&#13;&#10;//solution: check if the records are in history&#13;&#10;if max([invoice_date]) &lt;= max([Calculation_220394916815290368]) &#13;&#10;and max([invoice_date]) &lt; [Calculation_328199863975997441] //daan: strange, but it seems we really need this statement. (in order to prevent the running sum shows already today)&#13;&#10;&#13;&#10;then RUNNING_SUM(SUM([turnover_euro])) end'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ind_CY QTD' datatype='boolean' name='[Calculation_4051550864659570688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])' />
      </column>
      <column caption='ind_LY QTD' datatype='boolean' name='[Calculation_4051550864660381697]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Calculation_1813824758947549270])' />
      </column>
      <column caption='dummy date L4L' datatype='date' name='[Calculation_413205315849248770]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='//daan: this seems weird, however it works perfect:&#13;&#10;//my goal: compare monday this year with almost same date previous year also monday&#13;&#10;if [ind_CY (rel) (copy)_236720504437403659] then [invoice_date]&#13;&#10;elseif [ind_LY (copy)_413205315851259909] then [invoice_date]+364&#13;&#10;end' />
      </column>
      <column caption='day of week L4L' datatype='integer' name='[Calculation_413205315869618191]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='ISOWEEKDAY([Calculation_413205315849248770])' />
        <aliases>
          <alias key='1' value='M' />
          <alias key='2' value='T' />
          <alias key='3' value='W' />
          <alias key='4' value='Th' />
          <alias key='5' value='F' />
          <alias key='6' value='Sa' />
          <alias key='7' value='Su' />
        </aliases>
      </column>
      <column caption='ind_remove_future_years' datatype='boolean' name='[Calculation_5384053373402783745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='year([invoice_date])&lt;=year([Parameters].[Parameter 1])' />
      </column>
      <column caption='Customer Sales Business Unit Country' datatype='string' name='[Calculation_647392481332506624]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [customer_sales_business_unit] = &apos;Belgium&apos; AND [country_customer] = &apos;Luxembourg&apos; THEN [country_customer]&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;UK&apos; AND [country_customer] = &apos;Ireland&apos; THEN [country_customer]&#13;&#10;   // ELSEIF [Customer Sales Business Unit] = &apos;Spain&apos; AND [Country] = &apos;Portugal&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Export SEE&apos; AND [country_customer] = &apos;Bulgaria&apos; THEN [country_customer]&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Export SEE&apos; AND [country_customer] = &apos;Croatia&apos; THEN [country_customer]&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Export SEE&apos; AND [country_customer] = &apos;Slovenia&apos; THEN [country_customer]&#13;&#10;&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Estonia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Lithuania&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Latvia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Poland&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Agerpol&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Grene Retail&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Poland Franchise&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Recinsa&apos; THEN &apos;Spain&apos;&#13;&#10;    ELSEIF [customer_sales_business_unit] = &apos;Raico&apos; THEN &apos;Italy&apos;&#13;&#10;&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Croatia&apos; THEN [Country]&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [csbu_country_reporting] = &apos;Ireland&apos; then &apos;Republic of Ireland&apos; //Daan, 8/12/2025 toegevoegd nav mail Rutger. The goal: Everything related to Ireland, show it as ROI on the map&#13;&#10;&#13;&#10;ELSE [customer_sales_business_unit]&#13;&#10;END&#13;&#10;//daan 20240822: commented some lines out, because of CSBU change, see Viva' />
        <semantic-values semantic-role='[Geographical].[Longitude]'>
          <semantic-value key='&quot;Northern Ireland&quot;' value='-5.3904949999999996' />
        </semantic-values>
        <semantic-values semantic-role='[Geographical].[Latitude]'>
          <semantic-value key='&quot;Northern Ireland&quot;' value='54.036724' />
        </semantic-values>
        <semantic-values semantic-role='[Country].[Name]'>
          <semantic-value key='&quot;Agerpol&quot;' value='&quot;Poland&quot;' />
          <semantic-value key='&quot;Baltics&quot;' value='&quot;Lithuania&quot;' />
          <semantic-value key='&quot;Grene Retail&quot;' value='&quot;Poland&quot;' />
          <semantic-value key='&quot;INDI.nl&quot;' value='&quot;Netherlands&quot;' />
          <semantic-value key='&quot;Republic of Ireland (via NL)&quot;' value='&quot;Ireland&quot;' />
          <semantic-value key='&quot;WIS China&quot;' value='&quot;China&quot;' />
          <semantic-value key='&quot;WIS Denmark&quot;' value='&quot;Denmark&quot;' />
        </semantic-values>
        <desc>
          <formatted-text>
            <run>coming from CSBU and country</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='# invoicing days (for small multiples)' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_798825992117149696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;&#13;&#10;//difficult to fix this with 1 table, therefore I changed it, now I am using 2 tables in this workbook / data source&#13;&#10;//the second table: 1 record per CSBU per date. Therefore, much easier.&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_CY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [Sales Business Unit]: sum(if 1=1 and [ind_CY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;avg({FIXED [csbu_country_join (pres__obt__csbucountry_invoicing_dates)],year([invoice_date]), month([invoice_date]): &#13;&#10;sum(if 1=1 then [invoice_day (pres__obt__csbucountry_invoicing_dates)] end)})' />
      </column>
      <column caption='FX_impactToBudgetEuro' datatype='real' default-format='c&quot;€&quot;#,##0;(&quot;€&quot;#,##0)' name='[Calculation_837669592064262145]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[FX_LYDelta% (copy)_1698138576778956810]*sum([Turnover CY (copy)_1754433544815513601])&#13;&#10;//what is the impact in euro&apos;s&#13;&#10;//see also https://dub01.online.tableau.com/#/site/kramp/views/MonthlyGroupSalesReport/GroupSalesReport?:iid=1' />
