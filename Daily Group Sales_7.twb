      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='12'>Turnover EUR</run>
            <run>Æ &#10;</run>
            <run fontsize='10' italic='true'>(per month and 12-month moving average)</run>
          </formatted-text>
