                <run fontalignment='2' fontsize='8'><![CDATA[Current Year (CY): <[Grouped External Sales 2.0 (local copy) (copy)].[none:Calculation_1344324499169132544:ok]>  -   <[Grouped External Sales 2.0 (local copy) (copy)].[none:_CY: first date (copy)_1814950661680427018:ok]>]]></run>
                <run fontalignment='2'>Æ&#10;</run>
