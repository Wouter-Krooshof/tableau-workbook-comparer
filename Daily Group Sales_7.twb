            <groupfilter function='crossjoin' user:ui-action-filter='[Action8_489B61577D5A4B16BE8C6D22EB667A33]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:csbuCountry_Reporting:nk]' />
