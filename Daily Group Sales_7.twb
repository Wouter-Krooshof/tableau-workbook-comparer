                <run bold='true'><![CDATA[<[Grouped External Sales 2.0 (local copy) (copy)].[none:csbuCountry_Reporting:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#787878'>Country customer:&#9;</run>
                <run bold='true'><![CDATA[<[Grouped External Sales 2.0 (local copy) (copy)].[none:Calculation_647392481332506624:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#787878'>Overall score:&#9;</run>
                <run bold='true'><![CDATA[<[Grouped External Sales 2.0 (local copy) (copy)].[usr:Calculation_245164741975162884:qk]>]]></run>
              </formatted-text>
            </customized-tooltip>
