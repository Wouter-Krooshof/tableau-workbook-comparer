    <worksheet name='commerce score'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='20'>Æ   </run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Grouped External Sales 2.0 new' name='Grouped External Sales 2.0 (local copy) (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Grouped External Sales 2.0 (local copy) (copy)'>
            <column caption='# invoicing days LY' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[# invoicing days CY (copy)_1766818465106362372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;//for the colofon, do it per year&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_LY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [SalesBusinessUnit]: sum(if 1=1 and [ind_LY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)] end)})&#13;&#10;avg({FIXED [csbuCountryJoin (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]: &#13;&#10;sum(if 1=1 and [ind_LY (rel) (copy)_236720504437403660] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)] end)})' />
            </column>
            <column caption='% Turnover CY vs budget' datatype='real' default-format='p0.0%' name='[% Turnover CY vs comparison (copy) (copy)_1372190548062892043]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(sum([Calculation_1813824758949773404]) - sum([Turnover CY (copy)_1754433544815513601]))&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])' />
            </column>
            <column caption='% Daily average Orderlines CY vs LY' datatype='real' default-format='p0.0%' name='[% Turnover CY vs comparison (copy)_1766818465109512199 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1766818465106001922 1] - [Daily average turnover CY  (copy)_1766818465106255875 1])&#13;&#10;/&#13;&#10;[Daily average turnover CY  (copy)_1766818465106255875 1]' />
            </column>
            <column caption='% margin CY vs budget pp' datatype='real' default-format='*#,##0.0 pp;-#,##0.0 pp' name='[% margin CY vs comparison pp (copy) (copy)_245164741970190337]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1813824758953439329] - [Calculation_1372190548008140802]) *100&#13;&#10;//daan: pp because percentage point difference' />
            </column>
            <column caption='Budget Margin Euro' datatype='real' hidden='true' name='[BudgetMarginEuro]' role='measure' type='quantitative' />
            <column caption='Budget Turnover Euro' datatype='real' name='[BudgetTurnoverEuro]' role='measure' type='quantitative' />
            <column caption='Business Type' datatype='string' name='[Businesstype]' role='dimension' type='nominal' />
            <column caption='Margin CY' datatype='real' name='[CGS choosen CY (copy)_1813824758951571552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548006633472] end' />
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [source (CQM__VW__sal_groupedSalesForecast__IndustryBusinessType)]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
            </column>
            <column caption='Margin Eur' datatype='real' hidden='true' name='[Calculation_1372190548006633472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MarginEuro]&#13;&#10;//makes it easier to copy paste formulas from sales nordics' />
            </column>
            <column caption='Margin % budget CY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008140802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Turnover Budget CY (copy)_1754433544820387844])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])' />
            </column>
            <column caption='# Orderlines normal' datatype='real' name='[Calculation_1372190548022374405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1456914503679799305]' />
            </column>
            <column caption='# Orderlines' datatype='real' name='[Calculation_1456914503679799305]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='zn([NumberOfOrderlines_EDI]) + zn([NumberOfOrderlines_Manual]) + zn([NumberOfOrderlines_Webshop])' />
            </column>
            <column caption='Date per CSBU' datatype='date' name='[Calculation_1567252717417353216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//daan: handy to have a field in beteween. With this 1 I can - for test purposes - swith between the 2 date fields.&#13;&#10;//[Invoice Date]        //coming from hte big TO table&#13;&#10;//[dateFull (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]             //coming from the small dates table&#13;&#10;[dateFull]' />
            </column>
            <column caption='# invoicing days CY' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1766818465105641473]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='//goal: the sum of invoicingDays, but averaged over the CSBU&apos;s&#13;&#10;//so sum the amount of invoicingdays in a CSBU, and then take the avg&#13;&#10;&#13;&#10;//difficult to fix this with 1 table, therefore I changed it, now I am using 2 tables in this workbook / data source&#13;&#10;//the second table: 1 record per CSBU per date. Therefore, much easier.&#13;&#10;&#13;&#10;//avg({FIXED [Sales Business Unit],[year invoiceday]: sum(if 1=1 and [ind_CY] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;//avg({FIXED [Sales Business Unit]: sum(if 1=1 and [ind_CY] and [ind_relevant_for_invoicing_days2] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates)] end)})&#13;&#10;avg({FIXED [csbuCountryJoin (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]: &#13;&#10;sum(if 1=1 and [ind_CY (rel) (copy)_236720504437403659] then [InvoiceDay (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)] end)})' />
            </column>
            <column caption='Daily average # Orderlines CY' datatype='real' name='[Calculation_1766818465106001922 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Calculation_1813824758949773404 1])&#13;&#10;/ &#13;&#10;[Calculation_1766818465105641473]' />
            </column>
            <column caption='pm date feed ind (1)' datatype='boolean' name='[Calculation_1813824758940864589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//the goal: show all dates before today, but be carefull with yesterday. Yesterday should only be there if there is salesdata.&#13;&#10;&#13;&#10;&#13;&#10;//first step&#13;&#10;[InvoiceDate]&lt;TODAY() //not be in future (and not today)&#13;&#10;&#13;&#10;//second: only LY and CY&#13;&#10;and (&#13;&#10;        YEAR([InvoiceDate])=YEAR(TODAY())&#13;&#10;        OR &#13;&#10;        YEAR([InvoiceDate])=YEAR(TODAY())-1&#13;&#10;    )&#13;&#10;&#13;&#10;//third: yesterday only when there is certain sales sales data&#13;&#10;and if [InvoiceDate] = TODAY()-1&#13;&#10;    then &#13;&#10;        abs([Turnover])&gt;0 //if data is not yet refreshed in GBQ, then I don&apos;t want that date&#13;&#10;        and [CustomerSalesBusinessUnit] in (&apos;Netherlands&apos;,&apos;Denmark&apos;) //sometimes INDI is there already with only 7 euros. So if NL is ready, probably all countries are ready. There is no RLS so it will not harm.&#13;&#10;    else true &#13;&#10;    end' />
            </column>
            <column caption='pm date feed real (2)' datatype='date' name='[Calculation_1813824758941749326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if &#13;&#10;//1=1&#13;&#10;[Calculation_1813824758940864589] &#13;&#10;then [InvoiceDate] end&#13;&#10;//second step' />
            </column>
            <column caption='date last year' datatype='date' datatype-customized='true' name='[Calculation_1813824758947549270]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if MONTH([Parameters].[Parameter 1])=2 and day([Parameters].[Parameter 1])=28 and [Calculation_1918533485506887680] //year([pm_date])=2025 &#13;&#10;then DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) +1 //1 day every 4 years needed. The year after the leap year on last day of feb&#13;&#10;else DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) //normal situation&#13;&#10;end' />
            </column>
            <column caption='Turnover Eur' datatype='real' name='[Calculation_1813824758949527643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Turnover base]&#13;&#10;else [Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[TurnoverEuro]' />
            </column>
            <column caption='# Orderlines CY' datatype='real' name='[Calculation_1813824758949773404 1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548022374405] end' />
            </column>
            <column caption='Turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1813824758949773404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Margin % CY' datatype='real' default-format='p0.0%' name='[Calculation_1813824758953439329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CGS choosen CY (copy)_1813824758951571552])&#13;&#10;/&#13;&#10;sum([Calculation_1813824758949773404])' />
            </column>
            <column caption='ind_year_after_leap_year' datatype='boolean' name='[Calculation_1918533485506887680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*&#13;&#10;first line of code:&#13;&#10;2024 = 0&#13;&#10;2025 = 1 (because 20254/4 = 506.25 (so 1 is left and 1/4 = 0.25)&#13;&#10;2026 = 2&#13;&#10;2027 = 3&#13;&#10;2028 = 0&#13;&#10;*/&#13;&#10;&#13;&#10;year([Parameters].[Parameter 1])%4 &#13;&#10;= 1' />
            </column>
            <column caption='max_InvoiceDate LoD in order to feed default pm value' datatype='date' name='[Calculation_220394916815290368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(if [TurnoverEuro]&gt;0 and [InvoiceDate]&lt;=[Calculation_328199863975997441]-1 then [InvoiceDate] end)}&#13;&#10;//in order to feed the &quot;default pm value&quot;&#13;&#10;//daan: houdt geen rekening met verschillende BU&apos;s. Wellicht geen probleem. Voorbeeld: het is maandag. Er is 1 CSBU die gisteren&#13;&#10;//op zondag iets verkocht heeft. Dan is de default selectie zondag voor iedereen.&#13;&#10;//wil je graag t/m zaterdag kijken, dan pas je hem gewoon aan.' />
            </column>
            <column caption='Commerce score' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_245164741975162884]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;daan: I would like to give CSBU&apos;s that have big negative delta&apos;s in multiple KPI&apos;s a big alert&#13;&#10; zn(if [% Turnover CY vs budget]    &lt;-0.15      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs budget]    &lt;-0.1      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs budget]    &lt;-0.05     then 0.5 end)&#13;&#10; &#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.15     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.1     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs budget pp]   &lt;-0.05    then 0.5 end)&#13;&#10;&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.15   then 0.5 end)&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.1   then 0.5 end)&#13;&#10;+ zn(if [% Daily average Orderlines CY vs LY]   &lt;-0.05  then 0.5 end)&#13;&#10;*/&#13;&#10;&#13;&#10;zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.15      then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.1      then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &lt;-0.05     then -0.5 end)&#13;&#10;&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-1.5     then -0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-1     then -0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &lt;-0.5    then -0.5 end)&#13;&#10;&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.15   then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.1   then -0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &lt;-0.05  then -0.5 end)&#13;&#10;&#13;&#10;///////////////////////////////////////////////////////////////////////////plus////////////////////////////////////////////////////////////////&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.15      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.1      then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy) (copy)_1372190548062892043]    &gt;0.05     then 0.5 end)&#13;&#10;&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;1.5     then 0.5 end)&#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;1     then 0.5 end) &#13;&#10;+ zn(if  [% margin CY vs comparison pp (copy) (copy)_245164741970190337]   &gt;0.5    then 0.5 end) &#13;&#10;&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.15   then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.1   then 0.5 end)&#13;&#10;+ zn(if [% Turnover CY vs comparison (copy)_1766818465109512199 1]   &gt;0.05  then 0.5 end)' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='today()' />
            </column>
            <column caption='ind_CY QTD' datatype='boolean' name='[Calculation_4051550864659570688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_LY QTD' datatype='boolean' name='[Calculation_4051550864660381697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column caption='Customer Sales Business Unit Country' datatype='string' name='[Calculation_647392481332506624]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [CustomerSalesBusinessUnit] = &apos;Belgium&apos; AND [Country] = &apos;Luxembourg&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;UK&apos; AND [Country] = &apos;Ireland&apos; THEN [Country]&#13;&#10;   // ELSEIF [Customer Sales Business Unit] = &apos;Spain&apos; AND [Country] = &apos;Portugal&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Bulgaria&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Croatia&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Estonia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Lithuania&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Latvia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Poland&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Agerpol&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Grene Retail&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Poland Franchise&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Recinsa&apos; THEN &apos;Spain&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Raico&apos; THEN &apos;Italy&apos;&#13;&#10;&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Croatia&apos; THEN [Country]&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [csbuCountry_Reporting] = &apos;Ireland&apos; then &apos;Republic of Ireland&apos; //Daan, 8/12/2025 toegevoegd nav mail Rutger. The goal: Everything related to Ireland, show it as ROI on the map&#13;&#10;&#13;&#10;ELSE [CustomerSalesBusinessUnit]&#13;&#10;END&#13;&#10;//daan 20240822: commented some lines out, because of CSBU change, see Viva' />
              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;Northern Ireland&quot;' value='-5.3904949999999996' />
              </semantic-values>
              <semantic-values semantic-role='[Geographical].[Latitude]'>
                <semantic-value key='&quot;Northern Ireland&quot;' value='54.036724' />
              </semantic-values>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;Agerpol&quot;' value='&quot;Poland&quot;' />
                <semantic-value key='&quot;Baltics&quot;' value='&quot;Lithuania&quot;' />
                <semantic-value key='&quot;Grene Retail&quot;' value='&quot;Poland&quot;' />
                <semantic-value key='&quot;INDI.nl&quot;' value='&quot;Netherlands&quot;' />
                <semantic-value key='&quot;Republic of Ireland (via NL)&quot;' value='&quot;Ireland&quot;' />
                <semantic-value key='&quot;WIS China&quot;' value='&quot;China&quot;' />
                <semantic-value key='&quot;WIS Denmark&quot;' value='&quot;Denmark&quot;' />
              </semantic-values>
              <desc>
                <formatted-text>
                  <run>coming from CSBU and country</run>
                </formatted-text>
              </desc>
            </column>
