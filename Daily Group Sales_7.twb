          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[Grouped External Sales 2.0 (local copy) (copy)].[sum:Turnover CY (copy)_1698138576716890112:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[Grouped External Sales 2.0 (local copy) (copy)].[sum:Turnover Budget CY (copy)_1698138576777445384:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[Grouped External Sales 2.0 (local copy) (copy)].[sum:Turnover LY (copy)_1698138576716918785:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[Grouped External Sales 2.0 (local copy) (copy)].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[Grouped External Sales 2.0 (local copy) (copy)].[sum:Turnover:qk]&quot;</bucket>
