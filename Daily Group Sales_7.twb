          <datasource-dependencies datasource='Parameters'>
            <column caption='pm_date' datatype='date' default-value-field='[Grouped External Sales 2.0 (local copy) (copy)].[Calculation_220394916815290368]' name='[Parameter 1]' param-domain-type='list' role='measure' source-field='[Grouped External Sales 2.0 (local copy) (copy)].[Calculation_1813824758941749326]' type='quantitative' value='#2026-09-24#'>
              <calculation class='tableau' formula='#2026-09-24#' />
