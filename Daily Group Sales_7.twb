            <groupfilter function='empty-level' member='[none:csbuCountry_Reporting:nk]' user:ui-action-filter='[Action8_489B61577D5A4B16BE8C6D22EB667A33]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
