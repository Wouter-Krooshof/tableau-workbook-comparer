    <worksheet name='margin measures (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Grouped External Sales 2.0 new' name='Grouped External Sales 2.0 (local copy) (copy)' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Grouped External Sales 2.0 (local copy) (copy)'>
            <column caption='Budget Margin Euro' datatype='real' hidden='true' name='[BudgetMarginEuro]' role='measure' type='quantitative' />
            <column caption='Budget Turnover Euro' datatype='real' name='[BudgetTurnoverEuro]' role='measure' type='quantitative' />
            <column caption='Business Type Group' datatype='string' name='[Business Type Group 2 (copy)_1386545745140359168]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='// business type group 2 but then only for title of the tables&#13;&#10;[Business_Type_Group_2]' />
            </column>
            <column caption='Business Type Group 2' datatype='string' name='[Business_Type_Group_2]' role='dimension' type='nominal' />
            <column caption='Business Type' datatype='string' name='[Businesstype]' role='dimension' type='nominal' />
            <column caption='Margin CY' datatype='real' name='[CGS choosen CY (copy)_1813824758951571552]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1372190548006633472] end' />
            </column>
            <column caption='Sales region' datatype='string' name='[Calculation_1051872033104461825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//daan: in the old solution this was a group. I prefer a calculated field because it is more clear how it works.&#13;&#10;if [CustomerSalesBusinessUnit] = &apos;Agerpol&apos;                   then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Austria&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Baltics&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Belgium&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Bulgaria&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Croatia and Slovenia&apos;  then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Czech Republic&apos;        then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Denmark&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Export ROW&apos;            then &apos;ROW&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Export SEE&apos;            then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Finland&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;France&apos;                then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Germany&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Grene Retail&apos;          then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Hungary&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;INDI&apos;                  then &apos;INDI&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Italy&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Netherlands&apos;           then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Norway&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Poland&apos;                then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Poland Franchise&apos;      then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Raico&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Recinsa&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Republic of Ireland&apos;   then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Romania&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Russia&apos;                then &apos;Russia&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Slovakia&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Spain&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Sweden&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Switzerland&apos;           then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Ukraine&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;United Kingdom&apos;        then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;UK &amp; Ireland&apos;          then &apos;1 - North West&apos;   //Daan: added this one&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Tehnikakeskus&apos;          then &apos;3 - East&apos;        //Daan: added this one&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>coming from CSBU</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [source (CQM__VW__sal_groupedSalesForecast__IndustryBusinessType)]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
            </column>
            <column caption='Margin Eur' datatype='real' hidden='true' name='[Calculation_1372190548006633472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[MarginEuro]&#13;&#10;//makes it easier to copy paste formulas from sales nordics' />
            </column>
            <column caption='Margin % budget CY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008140802]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Turnover Budget CY (copy)_1754433544820387844])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1754433544815513601])' />
            </column>
            <column caption='Margin % LY' datatype='real' default-format='p0.0%' name='[Calculation_1372190548008853507]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Margin choosen CY (copy)_1195142760560619536])&#13;&#10;/&#13;&#10;sum([Turnover CY (copy)_1195142760512356366])' />
            </column>
            <column caption='Date per CSBU' datatype='date' name='[Calculation_1567252717417353216]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//daan: handy to have a field in beteween. With this 1 I can - for test purposes - swith between the 2 date fields.&#13;&#10;//[Invoice Date]        //coming from hte big TO table&#13;&#10;//[dateFull (CQM__VW__sal_businessUnitsInvoicingDates_groupedCountry)]             //coming from the small dates table&#13;&#10;[dateFull]' />
            </column>
            <column caption='pm date feed ind (1)' datatype='boolean' name='[Calculation_1813824758940864589]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//the goal: show all dates before today, but be carefull with yesterday. Yesterday should only be there if there is salesdata.&#13;&#10;&#13;&#10;&#13;&#10;//first step&#13;&#10;[InvoiceDate]&lt;TODAY() //not be in future (and not today)&#13;&#10;&#13;&#10;//second: only LY and CY&#13;&#10;and (&#13;&#10;        YEAR([InvoiceDate])=YEAR(TODAY())&#13;&#10;        OR &#13;&#10;        YEAR([InvoiceDate])=YEAR(TODAY())-1&#13;&#10;    )&#13;&#10;&#13;&#10;//third: yesterday only when there is certain sales sales data&#13;&#10;and if [InvoiceDate] = TODAY()-1&#13;&#10;    then &#13;&#10;        abs([Turnover])&gt;0 //if data is not yet refreshed in GBQ, then I don&apos;t want that date&#13;&#10;        and [CustomerSalesBusinessUnit] in (&apos;Netherlands&apos;,&apos;Denmark&apos;) //sometimes INDI is there already with only 7 euros. So if NL is ready, probably all countries are ready. There is no RLS so it will not harm.&#13;&#10;    else true &#13;&#10;    end' />
            </column>
            <column caption='pm date feed real (2)' datatype='date' name='[Calculation_1813824758941749326]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if &#13;&#10;//1=1&#13;&#10;[Calculation_1813824758940864589] &#13;&#10;then [InvoiceDate] end&#13;&#10;//second step' />
            </column>
            <column caption='date last year' datatype='date' datatype-customized='true' name='[Calculation_1813824758947549270]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='if MONTH([Parameters].[Parameter 1])=2 and day([Parameters].[Parameter 1])=28 and [Calculation_1918533485506887680] //year([pm_date])=2025 &#13;&#10;then DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) +1 //1 day every 4 years needed. The year after the leap year on last day of feb&#13;&#10;else DATE(DATEADD(&apos;year&apos;,-1,[Parameters].[Parameter 1])) //normal situation&#13;&#10;end' />
            </column>
            <column caption='Turnover Eur' datatype='real' name='[Calculation_1813824758949527643]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Turnover base]&#13;&#10;else [Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[TurnoverEuro]' />
            </column>
            <column caption='Turnover CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Calculation_1813824758949773404]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Margin % CY' datatype='real' default-format='p0.0%' name='[Calculation_1813824758953439329]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([CGS choosen CY (copy)_1813824758951571552])&#13;&#10;/&#13;&#10;sum([Calculation_1813824758949773404])' />
            </column>
            <column caption='ind_year_after_leap_year' datatype='boolean' name='[Calculation_1918533485506887680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='/*&#13;&#10;first line of code:&#13;&#10;2024 = 0&#13;&#10;2025 = 1 (because 20254/4 = 506.25 (so 1 is left and 1/4 = 0.25)&#13;&#10;2026 = 2&#13;&#10;2027 = 3&#13;&#10;2028 = 0&#13;&#10;*/&#13;&#10;&#13;&#10;year([Parameters].[Parameter 1])%4 &#13;&#10;= 1' />
            </column>
            <column caption='max_InvoiceDate LoD in order to feed default pm value' datatype='date' name='[Calculation_220394916815290368]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed: max(if [TurnoverEuro]&gt;0 and [InvoiceDate]&lt;=[Calculation_328199863975997441]-1 then [InvoiceDate] end)}&#13;&#10;//in order to feed the &quot;default pm value&quot;&#13;&#10;//daan: houdt geen rekening met verschillende BU&apos;s. Wellicht geen probleem. Voorbeeld: het is maandag. Er is 1 CSBU die gisteren&#13;&#10;//op zondag iets verkocht heeft. Dan is de default selectie zondag voor iedereen.&#13;&#10;//wil je graag t/m zaterdag kijken, dan pas je hem gewoon aan.' />
            </column>
            <column caption='Product Category' datatype='string' name='[Calculation_2686115737618796548]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//daan: technical reason I did not solve this in GBQ&#13;&#10;if [ProductCategory] = &apos;Other/Unknown&apos; then &apos;Other&apos;&#13;&#10;else [ProductCategory]&#13;&#10;end' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='today()' />
            </column>
            <column caption='ind_CY QTD' datatype='boolean' name='[Calculation_4051550864659570688]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Parameters].[Parameter 1]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_LY QTD' datatype='boolean' name='[Calculation_4051550864660381697]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;=[Calculation_1813824758947549270]&#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;quarter&apos;,[Calculation_1813824758947549270])' />
            </column>
            <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
            <column caption='Company Group' datatype='string' name='[CompanyGroup]' role='dimension' type='nominal' />
            <column caption='Customer Sales Business Unit' datatype='string' name='[CustomerSalesBusinessUnit]' role='dimension' type='nominal' />
            <column datatype='string' name='[Industry]' role='dimension' type='nominal' />
            <column caption='Invoice Date' datatype='date' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column caption='Margin LY' datatype='real' name='[Margin choosen CY (copy)_1195142760560619536]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_LY (rel) (copy)_236720504437403660] then [Calculation_1372190548006633472] end' />
            </column>
            <column caption='Margin Euro' datatype='real' hidden='true' name='[MarginEuro]' role='measure' type='quantitative' />
            <column datatype='string' name='[MarketType]' role='dimension' type='nominal' />
            <column caption='Product Category base' datatype='string' hidden='true' name='[ProductCategory]' role='dimension' type='nominal' />
            <column datatype='string' name='[Segment_4_local]' role='dimension' type='nominal'>
              <desc>
                <formatted-text>
                  <run>Also Lantmanne, Raiffeisen, RWZ, Employee Sales, etc.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Turnover Budget Eur' datatype='real' name='[Turnover (copy)_1754433544814776320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Budget Turnover]&#13;&#10;else [Budget Turnover Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[BudgetTurnoverEuro]' />
            </column>
            <column caption='Margin Budget' datatype='real' hidden='true' name='[Turnover Budget (copy)_1754433544820203523]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/*&#13;&#10;if [pm_local_EUR] = 1 then [Budget Margin]&#13;&#10;else [Budget Margin Euro]&#13;&#10;end&#13;&#10;*/&#13;&#10;[BudgetMarginEuro]' />
            </column>
            <column caption='Margin Budget CY' datatype='real' name='[Turnover Budget CY (copy)_1754433544820387844]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Turnover Budget (copy)_1754433544820203523] end' />
            </column>
            <column caption='Turnover LY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Turnover CY (copy)_1195142760512356366]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_LY (rel) (copy)_236720504437403660] then [Calculation_1813824758949527643] end' />
            </column>
            <column caption='Turnover Budget CY' datatype='real' default-format='n&quot;€&quot;#,##0;-&quot;€&quot;#,##0' name='[Turnover CY (copy)_1754433544815513601]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [ind_CY (rel) (copy)_236720504437403659] then [Turnover (copy)_1754433544814776320] end' />
            </column>
            <column caption='Turnover Euro' datatype='real' name='[TurnoverEuro]' role='measure' type='quantitative' />
            <column caption='Turnover base' datatype='real' name='[Turnover]' role='measure' type='quantitative' />
            <column datatype='string' name='[csbuCountry_Reporting]' role='dimension' semantic-role='' type='nominal'>
              <desc>
                <formatted-text>
                  <run>CSBUCountry as it is in CSBU_Hierarchy. We also manipulate this column in the field: csbuCountryJoin. See the comment for that field to read it in detail.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Date Full' datatype='date' name='[dateFull]' role='dimension' type='ordinal' />
            <column caption='ind_CY' datatype='boolean' name='[ind_CY (rel) (copy)_236720504437403659]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then [ind_CY MTD (rel) (copy)_236720504437403658]&#13;&#10;elseif [Parameters].[Parameter 2]=2 then [ind_CY YTD (rel) (copy)_236720504437403662]&#13;&#10;elseif [Parameters].[Parameter 2]=3 then [ind_CY_last 7 days (rel) (copy)_236720504437403661]&#13;&#10;elseif [Parameters].[Parameter 2]=4 then [ind_CY_last 28 days (rel) (copy)_236720504437403666]&#13;&#10;elseif [Parameters].[Parameter 2]=5 then [ind_CY_yesterday (rel) (copy)_236720504437403667]&#13;&#10;elseif [Parameters].[Parameter 2]=6 then [ind_CY_yesterday (copy)_837669592080760835]&#13;&#10;elseif [Parameters].[Parameter 2]=7 then [ind_CY MTD (copy)_1908681827015770114]&#13;&#10;elseif [Parameters].[Parameter 2]=8 then [ind_CY Full month (copy)_1352205831376080896]&#13;&#10;elseif [Parameters].[Parameter 2]=9 then [Calculation_4051550864659570688]&#13;&#10;end' />
            </column>
            <column caption='ind_CY Full Year' datatype='boolean' hidden='true' name='[ind_CY Full month (copy)_1352205831376080896]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year([Calculation_1567252717417353216]) = year([Parameters].[Parameter 1])' />
            </column>
            <column caption='ind_CY Full month' datatype='boolean' name='[ind_CY MTD (copy)_1908681827015770114]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1567252717417353216]&lt;DATETRUNC(&apos;month&apos;,DATEADD(&apos;month&apos;,1,[Parameters].[Parameter 1])) &#13;&#10;and &#13;&#10;[Calculation_1567252717417353216]&gt;=DATETRUNC(&apos;month&apos;,[Parameters].[Parameter 1])' />
            </column>
