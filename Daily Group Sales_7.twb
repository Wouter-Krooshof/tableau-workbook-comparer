            <column caption='Margin % LY (L4L)' datatype='real' default-format='p0.0%' name='[Margin % LY (copy)_413205315865034764]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='sum([Margin LY (copy)_413205315864948747])&#13;&#10;/&#13;&#10;sum([Turnover LY (copy)_413205315851210756])' />
