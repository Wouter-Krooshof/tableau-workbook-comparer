    <worksheet name='__LastDataUpdate (2)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Grouped External Sales 2.0 new' name='Grouped External Sales 2.0 (local copy) (copy)' />
          </datasources>
          <datasource-dependencies datasource='Grouped External Sales 2.0 (local copy) (copy)'>
            <column datatype='string' name='[Business_Type_Group_1]' role='dimension' type='nominal' />
            <column caption='Business Type Group 2' datatype='string' name='[Business_Type_Group_2]' role='dimension' type='nominal' />
            <column caption='Business Type' datatype='string' name='[Businesstype]' role='dimension' type='nominal' />
            <column caption='Sales region' datatype='string' name='[Calculation_1051872033104461825]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//daan: in the old solution this was a group. I prefer a calculated field because it is more clear how it works.&#13;&#10;if [CustomerSalesBusinessUnit] = &apos;Agerpol&apos;                   then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Austria&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Baltics&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Belgium&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Bulgaria&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Croatia and Slovenia&apos;  then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Czech Republic&apos;        then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Denmark&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Export ROW&apos;            then &apos;ROW&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Export SEE&apos;            then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Finland&apos;               then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;France&apos;                then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Germany&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Grene Retail&apos;          then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Hungary&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;INDI&apos;                  then &apos;INDI&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Italy&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Netherlands&apos;           then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Norway&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Poland&apos;                then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Poland Franchise&apos;      then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Raico&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Recinsa&apos;               then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Republic of Ireland&apos;   then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Romania&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Russia&apos;                then &apos;Russia&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Slovakia&apos;              then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Spain&apos;                 then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Sweden&apos;                then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Switzerland&apos;           then &apos;2- South West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Ukraine&apos;               then &apos;3 - East&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;United Kingdom&apos;        then &apos;1 - North West&apos;&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;UK &amp; Ireland&apos;          then &apos;1 - North West&apos;   //Daan: added this one&#13;&#10;elseif [CustomerSalesBusinessUnit] = &apos;Tehnikakeskus&apos;          then &apos;3 - East&apos;        //Daan: added this one&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>coming from CSBU</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [source (CQM__VW__sal_groupedSalesForecast__IndustryBusinessType)]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
            </column>
            <column caption='Max InvoiceDate on Invoice day and with Turnover' datatype='date' name='[Calculation_1613977551456641036]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='MAX(IF [TurnoverEuro]!=0 &#13;&#10;//AND [Invoiceday]=1  decided to comment this out because makes no sense&#13;&#10;THEN [InvoiceDate] END)' />
            </column>
            <column caption='Yesterday or Friday (Input traffic light)' datatype='datetime' name='[Calculation_3175882162430353408]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='//yesterday (or 2 days ago if today is Sunday or Monday)&#13;&#10;    DATEADD&#13;&#10;            (&apos;day&apos;&#13;&#10;            ,if DATEPART(&#13;&#10;                           &apos;weekday&apos;,TODAY()&#13;&#10;                        )&#13;&#10;                 //equals 1 means Sunday. If Sunday, then Friday because Saturday is always very late!?&#13;&#10;                 //equals 2 means Monday. If Monday, then Saturday because Sunday does not always have sales data.&#13;&#10;                in (1,2) then -2 &#13;&#10;                                    // *11/06/2024 update* because there were some wrong colors on sunday, we changed this part of the code from -3 to -2.&#13;&#10;                else -1 //else -1 so Yesterday.&#13;&#10;             END&#13;&#10;            ,[Calculation_328199863975997441]&#13;&#10;            )' />
            </column>
            <column caption='today' datatype='date' name='[Calculation_328199863975997441]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='today()' />
            </column>
            <column caption='Customer Sales Business Unit Country' datatype='string' name='[Calculation_647392481332506624]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
              <calculation class='tableau' formula='IF [CustomerSalesBusinessUnit] = &apos;Belgium&apos; AND [Country] = &apos;Luxembourg&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;UK&apos; AND [Country] = &apos;Ireland&apos; THEN [Country]&#13;&#10;   // ELSEIF [Customer Sales Business Unit] = &apos;Spain&apos; AND [Country] = &apos;Portugal&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Bulgaria&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Croatia&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Estonia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Lithuania&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Latvia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Poland&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Agerpol&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Grene Retail&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Poland Franchise&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Recinsa&apos; THEN &apos;Spain&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Raico&apos; THEN &apos;Italy&apos;&#13;&#10;&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Croatia&apos; THEN [Country]&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [csbuCountry_Reporting] = &apos;Ireland&apos; then &apos;Republic of Ireland&apos; //Daan, 8/12/2025 toegevoegd nav mail Rutger. The goal: Everything related to Ireland, show it as ROI on the map&#13;&#10;&#13;&#10;ELSE [CustomerSalesBusinessUnit]&#13;&#10;END&#13;&#10;//daan 20240822: commented some lines out, because of CSBU change, see Viva' />
              <semantic-values semantic-role='[Geographical].[Longitude]'>
                <semantic-value key='&quot;Northern Ireland&quot;' value='-5.3904949999999996' />
              </semantic-values>
              <semantic-values semantic-role='[Geographical].[Latitude]'>
                <semantic-value key='&quot;Northern Ireland&quot;' value='54.036724' />
              </semantic-values>
              <semantic-values semantic-role='[Country].[Name]'>
                <semantic-value key='&quot;Agerpol&quot;' value='&quot;Poland&quot;' />
                <semantic-value key='&quot;Baltics&quot;' value='&quot;Lithuania&quot;' />
                <semantic-value key='&quot;Grene Retail&quot;' value='&quot;Poland&quot;' />
                <semantic-value key='&quot;INDI.nl&quot;' value='&quot;Netherlands&quot;' />
                <semantic-value key='&quot;Republic of Ireland (via NL)&quot;' value='&quot;Ireland&quot;' />
                <semantic-value key='&quot;WIS China&quot;' value='&quot;China&quot;' />
                <semantic-value key='&quot;WIS Denmark&quot;' value='&quot;Denmark&quot;' />
              </semantic-values>
              <desc>
                <formatted-text>
                  <run>coming from CSBU and country</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
            <column caption='Company Group' datatype='string' name='[CompanyGroup]' role='dimension' type='nominal' />
            <column datatype='string' hidden='true' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column caption='Customer Sales Business Unit' datatype='string' name='[CustomerSalesBusinessUnit]' role='dimension' type='nominal' />
            <column datatype='string' name='[Industry]' role='dimension' type='nominal' />
            <column caption='Invoice Date' datatype='date' name='[InvoiceDate]' role='dimension' type='ordinal' />
            <column caption='Last Turnover Was Yesterday3 (traffic light)' datatype='boolean' name='[Last Turnover Was Yesterday2 (copy)]' role='measure' type='nominal'>
              <calculation class='tableau' formula='/*&#13;&#10;Daan. Goal: check and show if there is data from yesterday***&#13;&#10;***or day before yesterday&#13;&#10;&#13;&#10;part 1: if weekday =1 or 2 (sunday or monday) we check only NL&#13;&#10;part 2: for all other days, we check NL AND DK&#13;&#10;&#13;&#10;//we do not check all countries, because somehow there is already little turnover for INDI (7 euros), but for all other CSBU&apos;s there is nothing.&#13;&#10;//so if we check NL, then all other OMS countries will probably also be there&#13;&#10;&#13;&#10;//DK does not always have data on sunday, thats why we do not check DK on all days.&#13;&#10;*/&#13;&#10;&#13;&#10;//////////////////////////////////////////////////////////////part 1/////////////////////////////////////////////&#13;&#10;if DATEPART(&apos;weekday&apos;,TODAY()) in (1,2) then&#13;&#10;(&#13;&#10;    MAX(&#13;&#10;        DATE(&#13;&#10;              {fixed:max(IF [TurnoverEuro]&gt;100 and [CustomerSalesBusinessUnit]=&apos;Netherlands&apos; then [InvoiceDate] END)}&#13;&#10;             )&#13;&#10;        ) &#13;&#10;&#13;&#10;    //2. should be equal to a certain date&#13;&#10;    &gt;=&#13;&#10;    //yesterday most of the times&#13;&#10;   [Calculation_3175882162430353408]&#13;&#10;)&#13;&#10;//////////////////////////////////////////////////////////////part 2/////////////////////////////////////////////&#13;&#10;else&#13;&#10;(&#13;&#10;    MAX(&#13;&#10;        DATE(&#13;&#10;              {fixed:max(IF [TurnoverEuro]&gt;100 and [CustomerSalesBusinessUnit]=&apos;Netherlands&apos; then [InvoiceDate] END)}&#13;&#10;             )&#13;&#10;        ) &#13;&#10;&#13;&#10;    //2. should be equal to a certain date&#13;&#10;    &gt;=&#13;&#10;    //yesterday most of the times&#13;&#10;   [Calculation_3175882162430353408]&#13;&#10;)&#13;&#10;AND&#13;&#10;(&#13;&#10;    MAX(&#13;&#10;        DATE(&#13;&#10;              {fixed:max(IF [TurnoverEuro]&gt;100 and [CustomerSalesBusinessUnit]=&apos;Denmark&apos; then [InvoiceDate] END)}&#13;&#10;             )&#13;&#10;        ) &#13;&#10;&#13;&#10;    //2. should be equal to a certain date&#13;&#10;    &gt;=&#13;&#10;    //yesterday most of the times&#13;&#10;   [Calculation_3175882162430353408]&#13;&#10;)  &#13;&#10;&#13;&#10;end' />
            </column>
            <column datatype='string' name='[MarketType]' role='dimension' type='nominal' />
            <column datatype='string' name='[Segment_2_Industry]' role='dimension' type='nominal'>
              <desc>
                <formatted-text>
                  <run>Agri, Construction, F&amp;G, OEM, MRO, Other</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Segment_4_local]' role='dimension' type='nominal'>
              <desc>
                <formatted-text>
                  <run>Also Lantmanne, Raiffeisen, RWZ, Employee Sales, etc.</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Turnover Euro' datatype='real' name='[TurnoverEuro]' role='measure' type='quantitative' />
            <column datatype='string' name='[csbuCountry_Reporting]' role='dimension' semantic-role='' type='nominal'>
              <desc>
                <formatted-text>
                  <run>CSBUCountry as it is in CSBU_Hierarchy. We also manipulate this column in the field: csbuCountryJoin. See the comment for that field to read it in detail.</run>
                </formatted-text>
              </desc>
            </column>
            <column-instance column='[Business_Type_Group_1]' derivation='None' name='[none:Business_Type_Group_1:nk]' pivot='key' type='nominal' />
            <column-instance column='[Business_Type_Group_2]' derivation='None' name='[none:Business_Type_Group_2:nk]' pivot='key' type='nominal' />
            <column-instance column='[Businesstype]' derivation='None' name='[none:Businesstype:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1051872033104461825]' derivation='None' name='[none:Calculation_1051872033104461825:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1356427944749383680]' derivation='None' name='[none:Calculation_1356427944749383680:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_647392481332506624]' derivation='None' name='[none:Calculation_647392481332506624:nk]' pivot='key' type='nominal' />
            <column-instance column='[CompanyGroup]' derivation='None' name='[none:CompanyGroup:nk]' pivot='key' type='nominal' />
            <column-instance column='[CustomerSalesBusinessUnit]' derivation='None' name='[none:CustomerSalesBusinessUnit:nk]' pivot='key' type='nominal' />
            <column-instance column='[Industry]' derivation='None' name='[none:Industry:nk]' pivot='key' type='nominal' />
            <column-instance column='[MarketType]' derivation='None' name='[none:MarketType:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment_2_Industry]' derivation='None' name='[none:Segment_2_Industry:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment_4_local]' derivation='None' name='[none:Segment_4_local:nk]' pivot='key' type='nominal' />
            <column-instance column='[csbuCountry_Reporting]' derivation='None' name='[none:csbuCountry_Reporting:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[source (CQM__VW__sal_groupedSalesForecast__IndustryBusinessType)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1613977551456641036]' derivation='User' name='[usr:Calculation_1613977551456641036:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Last Turnover Was Yesterday2 (copy)]' derivation='User' name='[usr:Last Turnover Was Yesterday2 (copy):nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[none:Business_Type_Group_1:nk]' filter-group='26'>
            <groupfilter function='level-members' level='[none:Business_Type_Group_1:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[none:Business_Type_Group_2:nk]' filter-group='27'>
            <groupfilter function='level-members' level='[none:Business_Type_Group_2:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[none:Calculation_1051872033104461825:nk]'>
            <groupfilter function='level-members' level='[none:Calculation_1051872033104461825:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[none:Calculation_647392481332506624:nk]' filter-group='12'>
            <groupfilter function='level-members' level='[none:Calculation_647392481332506624:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[Grouped External Sales 2.0 (local copy) (copy)].[none:Segment_2_Industry:nk]' filter-group='11'>
            <groupfilter function='level-members' level='[none:Segment_2_Industry:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <slices>
