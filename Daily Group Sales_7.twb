      <repository-location derived-from='https://dub01.online.tableau.com/t/kramp/workbooks/DailyGroupSales/Trends?rev=' id='Trends' path='/t/kramp/workbooks/DailyGroupSales' revision='' site='kramp' />
      <style>
        <style-rule element='dash-text'>
          <format attr='font-size' value='8' />
          <format attr='vertical-align' id='dash-text_77' value='top' />
          <format attr='text-align' id='dash-text_180' value='right' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#222222' />
          <format attr='background-color' value='#00000000' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' preset-index='1' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Grouped External Sales 2.0 new' name='Grouped External Sales 2.0 (local copy) (copy)' />
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Grouped External Sales 2.0 (local copy) (copy)'>
        <column caption='Business Type' datatype='string' name='[Businesstype]' role='dimension' type='nominal' />
        <column caption='index()' datatype='integer' name='[Calculation_1480839898648948739]' role='measure' type='quantitative'>
          <calculation class='tableau' formula='index()'>
            <table-calc ordering-type='Rows' />
          </calculation>
        </column>
        <column caption='Product Category' datatype='string' name='[Calculation_2686115737618796548]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='//daan: technical reason I did not solve this in GBQ&#13;&#10;if [ProductCategory] = &apos;Other/Unknown&apos; then &apos;Other&apos;&#13;&#10;else [ProductCategory]&#13;&#10;end' />
        </column>
        <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
        <column caption='Company Group' datatype='string' name='[CompanyGroup]' role='dimension' type='nominal' />
        <column caption='Customer Sales Business Unit' datatype='string' name='[CustomerSalesBusinessUnit]' role='dimension' type='nominal' />
        <column datatype='string' name='[Industry]' role='dimension' type='nominal' />
        <column datatype='string' name='[MarketType]' role='dimension' type='nominal' />
        <column datatype='string' name='[Segment_4_local]' role='dimension' type='nominal'>
          <desc>
            <formatted-text>
              <run>Also Lantmanne, Raiffeisen, RWZ, Employee Sales, etc.</run>
            </formatted-text>
          </desc>
        </column>
        <column datatype='string' name='[csbuCountry_Reporting]' role='dimension' semantic-role='' type='nominal'>
          <desc>
            <formatted-text>
              <run>CSBUCountry as it is in CSBU_Hierarchy. We also manipulate this column in the field: csbuCountryJoin. See the comment for that field to read it in detail.</run>
            </formatted-text>
          </desc>
        </column>
        <column-instance column='[Businesstype]' derivation='None' name='[none:Businesstype:nk]' pivot='key' type='nominal' />
        <column-instance column='[Calculation_2686115737618796548]' derivation='None' name='[none:Calculation_2686115737618796548:nk]' pivot='key' type='nominal' />
        <column-instance column='[CompanyGroup]' derivation='None' name='[none:CompanyGroup:nk]' pivot='key' type='nominal' />
        <column-instance column='[CustomerSalesBusinessUnit]' derivation='None' name='[none:CustomerSalesBusinessUnit:nk]' pivot='key' type='nominal' />
        <column-instance column='[Industry]' derivation='None' name='[none:Industry:nk]' pivot='key' type='nominal' />
        <column-instance column='[MarketType]' derivation='None' name='[none:MarketType:nk]' pivot='key' type='nominal' />
        <column-instance column='[Segment_4_local]' derivation='None' name='[none:Segment_4_local:nk]' pivot='key' type='nominal' />
        <column-instance column='[csbuCountry_Reporting]' derivation='None' name='[none:csbuCountry_Reporting:nk]' pivot='key' type='nominal' />
        <column caption='per what 2' datatype='string' name='[per what filter segment (copy)_280630594442031106]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [Parameters].[pm_per what 1 (segment or product category) (copy)_280630594441756673 1]&#13;&#10;WHEN 1 then [Segment_2_Industry]&#13;&#10;WHEN 2 then [Calculation_2686115737618796548]&#13;&#10;WHEN 3 THEN [csbuCountry_Reporting]&#13;&#10;WHEN 4 THEN [Segment_4_local]&#13;&#10;WHEN 6 THEN [MarketType] &#13;&#10;WHEN 7 THEN [Cluster] &#13;&#10;WHEN 8 THEN [Industry] &#13;&#10;WHEN 9 THEN [Businesstype]&#13;&#10;WHEN 10 THEN [Business_Type_Group_1]&#13;&#10;WHEN 11 THEN [Business_Type_Group_2]&#13;&#10;WHEN 12 THEN [CustomerSalesBusinessUnit]&#13;&#10;ELSE Null end' />
        </column>
        <column-instance column='[Calculation_1480839898648948739]' derivation='User' name='[usr:Calculation_1480839898648948739:qk:2]' pivot='key' type='quantitative'>
          <table-calc ordering-field='[Grouped External Sales 2.0 (local copy) (copy)].[per what filter segment (copy)_280630594442031106]' ordering-type='Field' />
