    <dashboard enable-sort-zone-taborder='true' name='Landing Page'>
      <repository-location derived-from='https://dub01.online.tableau.com/t/kramp/workbooks/DailyGroupSales/LandingPage?rev=' id='LandingPage' path='/t/kramp/workbooks/DailyGroupSales' revision='' site='kramp' />
      <style>
        <style-rule element='dash-text'>
          <format attr='font-size' value='8' />
          <format attr='vertical-align' id='dash-text_77' value='top' />
        </style-rule>
        <style-rule element='parameter-ctrl'>
          <format attr='color' value='#222222' />
          <format attr='background-color' value='#00000000' />
        </style-rule>
      </style>
      <size maxheight='900' maxwidth='1300' minheight='900' minwidth='1300' preset-index='1' sizing-mode='fixed' />
      <datasources>
        <datasource caption='Grouped External Sales 2.0 new' name='Grouped External Sales 2.0 (local copy) (copy)' />
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Grouped External Sales 2.0 (local copy) (copy)'>
        <column caption='Business Type' datatype='string' name='[Businesstype]' role='dimension' type='nominal' />
        <column caption='View' datatype='string' name='[Calculation_1356427944749383680]' role='dimension' type='nominal'>
          <calculation class='tableau' formula='CASE [source (CQM__VW__sal_groupedSalesForecast__IndustryBusinessType)]&#13;&#10;     when  &apos;Contingency_Rows&apos; THEN &apos;Include Budget Contingency&apos;&#13;&#10;     when  &apos;DailyGroupSales_rows&apos; THEN &apos;Default View&apos;&#13;&#10;END' />
        </column>
        <column caption='Customer Sales Business Unit Country' datatype='string' name='[Calculation_647392481332506624]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
          <calculation class='tableau' formula='IF [CustomerSalesBusinessUnit] = &apos;Belgium&apos; AND [Country] = &apos;Luxembourg&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;UK&apos; AND [Country] = &apos;Ireland&apos; THEN [Country]&#13;&#10;   // ELSEIF [Customer Sales Business Unit] = &apos;Spain&apos; AND [Country] = &apos;Portugal&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Bulgaria&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Croatia&apos; THEN [Country]&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Export SEE&apos; AND [Country] = &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Estonia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Lithuania&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Latvia&apos; THEN [Country]&#13;&#10;    //ELSEIF [Customer Sales Business Unit] = &apos;Baltics&apos; AND [Country] = &apos;Poland&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Agerpol&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Grene Retail&apos; THEN &apos;Poland&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Poland Franchise&apos; THEN &apos;Poland&apos;&#13;&#10;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Recinsa&apos; THEN &apos;Spain&apos;&#13;&#10;    ELSEIF [CustomerSalesBusinessUnit] = &apos;Raico&apos; THEN &apos;Italy&apos;&#13;&#10;&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Croatia&apos; THEN [Country]&#13;&#10;  //  ElSEIF [Customer Sales Business Unit] = &apos;Croatia and Slovenia&apos; AND [Country]= &apos;Slovenia&apos; THEN [Country]&#13;&#10;&#13;&#10;    ELSEIF [csbuCountry_Reporting] = &apos;Ireland&apos; then &apos;Republic of Ireland&apos; //Daan, 8/12/2025 toegevoegd nav mail Rutger. The goal: Everything related to Ireland, show it as ROI on the map&#13;&#10;&#13;&#10;ELSE [CustomerSalesBusinessUnit]&#13;&#10;END&#13;&#10;//daan 20240822: commented some lines out, because of CSBU change, see Viva' />
          <semantic-values semantic-role='[Geographical].[Longitude]'>
            <semantic-value key='&quot;Northern Ireland&quot;' value='-5.3904949999999996' />
          </semantic-values>
          <semantic-values semantic-role='[Geographical].[Latitude]'>
            <semantic-value key='&quot;Northern Ireland&quot;' value='54.036724' />
          </semantic-values>
          <semantic-values semantic-role='[Country].[Name]'>
            <semantic-value key='&quot;Agerpol&quot;' value='&quot;Poland&quot;' />
            <semantic-value key='&quot;Baltics&quot;' value='&quot;Lithuania&quot;' />
            <semantic-value key='&quot;Grene Retail&quot;' value='&quot;Poland&quot;' />
            <semantic-value key='&quot;INDI.nl&quot;' value='&quot;Netherlands&quot;' />
            <semantic-value key='&quot;Republic of Ireland (via NL)&quot;' value='&quot;Ireland&quot;' />
            <semantic-value key='&quot;WIS China&quot;' value='&quot;China&quot;' />
            <semantic-value key='&quot;WIS Denmark&quot;' value='&quot;Denmark&quot;' />
          </semantic-values>
          <desc>
            <formatted-text>
              <run>coming from CSBU and country</run>
            </formatted-text>
          </desc>
        </column>
        <column datatype='string' name='[Cluster]' role='dimension' type='nominal' />
        <column caption='Company Group' datatype='string' name='[CompanyGroup]' role='dimension' type='nominal' />
