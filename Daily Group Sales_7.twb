            </column>
            <column caption='ind_LY' datatype='boolean' name='[ind_LY (rel) (copy)_236720504437403660]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if [Parameters].[Parameter 2]=1 then [ind_LY MTD (rel) (copy)_236720504437403663]&#13;&#10;elseif [Parameters].[Parameter 2]=2 then [ind_LY YTD (rel) (copy)_236720504437403664]&#13;&#10;elseif [Parameters].[Parameter 2]=3 then [ind_LY_last 7 days (rel) (copy)_236720504437403665]&#13;&#10;elseif [Parameters].[Parameter 2]=4 then [ind_LY_last 28 days (rel) (copy)_236720504437403669]&#13;&#10;elseif [Parameters].[Parameter 2]=5 then [ind_LY_yesterday (rel) (copy)_236720504437403668]&#13;&#10;elseif [Parameters].[Parameter 2]=6 then [ind_LY_last 7 days (copy)_837669592102621188]&#13;&#10;elseif [Parameters].[Parameter 2]=7 then [ind_LY MTD (copy)_1908681827018035203]&#13;&#10;elseif [Parameters].[Parameter 2]=8 then [ind_LY Full Month (copy)_1352205831377436673]&#13;&#10;elseif [Parameters].[Parameter 2]=9 then [Calculation_4051550864660381697]&#13;&#10;else false&#13;&#10;end' />
            </column>
            <column caption='ind_LY Full Year' datatype='boolean' hidden='true' name='[ind_LY Full Month (copy)_1352205831377436673]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='year([Calculation_1567252717417353216]) = year([Parameters].[Parameter 1]) - 1' />
